raw `
.set LOCALID_VEE, 4
.set LOCALID_FRO, 5
.set PlayerXCoordinates, VAR_TEMP_3
.set PlayerYCoordinates, VAR_TEMP_4
`
mapscripts VoltbrookTown_MapScripts
{
	MAP_SCRIPT_ON_LOAD
	{
		setrespawn(HEAL_LOCATION_VOLTBROOK_TOWN)
		// if(flag(FLAG_DEFEATED_MAGA_ELECTAVIRE))
		// {
		// 	setmetatile(7, 17, DOOR, TRUE)
		// 	setmetatile(5, 23, CENTER_DOOR, TRUE)
		// 	setmetatile(19, 25, DOOR, TRUE)
		// 	setmetatile(27, 13, DOOR, TRUE)
		// 	setmetatile(31, 17, MART_DOOR, TRUE)
		// }
		release
		end
    }
}


script Voltbrook_EventScripts_GruntPatrolChat
{
    lock
	getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
	special(SpawnCameraObject)
	if(var(PlayerYCoordinates) == 6)
		{
			applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_right*5 walk_down*4))
			waitmovement(OBJ_EVENT_ID_CAMERA)
		}
	if(var(PlayerYCoordinates) == 7)
		{
			applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_right*5 walk_down*3))
			waitmovement(OBJ_EVENT_ID_CAMERA)
		}
	if(var(PlayerYCoordinates) == 8)
		{
			applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_right*5 walk_down*2))
			waitmovement(OBJ_EVENT_ID_CAMERA)
		}
    speakername("Grunt 1")
    msgbox(format("I can't believe those failures got away."))
	waitmovement(2)
    speakername("Grunt 2")
    msgbox(format("They might be failures, but they still escaped."))
    speakername("Grunt 3")
    msgbox(format("They couldn't have possibly made it far from the lab, right?"))
    speakername("Grunt 1")
    msgbox(format("That sorry bunch?\nHa! No shot."))
    speakername("Grunt 2")
    msgbox(format("Talk less and search more.\NHQ is expecting us to return soon."))
    speakername("Grunt 3")
    msgbox(format("Let's split up and cover the whole town."))
	closemessage
	applymovement(1,moves(walk_left*2 walk_down*8))
	applymovement(2,moves(walk_down*2 walk_right*2 walk_down*6))
	applymovement(3,moves(walk_right*10))
	waitmovement(3)
	removeobject(1)
	removeobject(2)
	removeobject(3)
	setobjectxyperm(3, 26, 8)
	setobjectxyperm(2, 25, 6)
	addobject(2)
	addobject(3)
	if(var(PlayerYCoordinates) == 6)
		{
			applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up*4 walk_left*5))
			waitmovement(OBJ_EVENT_ID_CAMERA)
		}
	if(var(PlayerYCoordinates) == 7)
		{
			applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up*3 walk_left*5))
			waitmovement(OBJ_EVENT_ID_CAMERA)
		}
	if(var(PlayerYCoordinates) == 8)
		{
			applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up*2 walk_left*5))
			waitmovement(OBJ_EVENT_ID_CAMERA)
		}
	special(RemoveCameraObject)
	setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
	addobject(LOCALID_VEE)
	applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerEast)
	playse(SE_PIN)
	applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_right))
	waitmovement(OBJ_EVENT_ID_PLAYER)
    speakername("Vee")
    msgbox(format("Oh no, Seel, they’re everywhere!\p
	Is there really no place to hide?\p
	Maybe we should just…\n
	Give up.\p
	Maybe if we hand ourselves in, they'll be less mean to us…\p
	… … …\n
	No, I don't wanna go back in there!\p
	Let’s stick close and keep our heads down, okay?\p
	We’ll find that artifact. I know we will."))
    applymovement(LOCALID_VEE, Common_Movement_PartyMemberReturnsToPlayerEast)
	waitmovement(LOCALID_VEE)
	removeobject(LOCALID_VEE)
	setvar(VAR_VOLTBROOK_TOWN_STATE, 2)
	release
    end
}

script Voltbrook_EventScripts_GruntCatchesPlayerLeaving
	{
		lock
		applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_down))
		waitmovement(OBJ_EVENT_ID_PLAYER)
		getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
			switch(var(PlayerXCoordinates))
				{
					case 22:	
						setobjectxyperm(1, 22, 21)
						addobject(1)
						speakername("???")
						msgbox(format("Where do you think you're going?"))
						closemessage
						applymovement(1, moves(walk_faster_down*5 walk_faster_right walk_faster_down*2 walk_faster_left face_up emote_exclamation_mark))
						waitmovement(1)
						playse(SE_PIN)
						waitse
						speakername("Grunt 1")
						msgbox(format("Hey, you're the lab escapees!\p
						Easy, now.\n
						Just come with us, and we won't hurt you, alright?\p
						Not any more than necessary, at least."))
						setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
						addobject(LOCALID_VEE)
						applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerEast)
						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_right))
						waitmovement(LOCALID_VEE)
						speakername("Vee")
						playse(SE_PIN)
						msgbox(format(
							"N-no… They found us!\n
							T-there's no way to run!\p
							S-seel, I…\n
							I don't wanna go back in there, but…\p
							I don't want to fight either!\n
							I really don't!\p
							But…\n
							We need to.\p
							If it's with you… I can do it!\p
							Let's show them, Seel!\n
							We're not just failed experiments!"))
						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_down))
						applymovement(LOCALID_VEE,moves(walk_in_place_down))
						waitmovement(OBJ_EVENT_ID_PLAYER)
						delay(40)
						speakername("Grunt 1")
						trainerbattle_double(TRAINER_MAGA_GRUNT_VOLTBROOK_TOWN, format(
							"Hard way it is, then. Fine by me!\pI get to stop pretending to be nice."),format("How… How could a couple of failed experiments beat me?"),"NULL",AfterBattle_Test)
					case 23:
						setobjectxyperm(1, 23, 21)
						addobject(1)
						speakername("???")
						msgbox(format("Where do you think you're going?"))
						closemessage
						applymovement(1, moves(walk_faster_down*5 walk_faster_right walk_faster_down*2 walk_faster_left face_up emote_exclamation_mark))
						waitmovement(1)
						playse(SE_PIN)
						waitse
						speakername("Grunt 1")
						msgbox(format("Hey, you're the lab escapees!\p
						Easy, now.\n
						Just come with us, and we won't hurt you, alright?\p
						Not any more than necessary, at least."))
						setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
						addobject(LOCALID_VEE)
						applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerEast)
						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_right))
						waitmovement(LOCALID_VEE)
						speakername("Vee")
						playse(SE_PIN)
						msgbox(format(
							"N-no… They found us!\n
							T-there's no way to run!\p
							S-seel, I…\n
							I don't wanna go back in there, but…\p
							I don't want to fight either!\n
							I really don't!\p
							But…\n
							We need to.\p
							If it's with you… I can do it!\p
							Let's show them, Seel!\n
							We're not just failed experiments!"))
						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_down))
						applymovement(LOCALID_VEE,moves(walk_in_place_down))
						waitmovement(OBJ_EVENT_ID_PLAYER)
						delay(40)
						speakername("Grunt 1")
						trainerbattle_double(TRAINER_MAGA_GRUNT_VOLTBROOK_TOWN, format(
							"Hard way it is, then. Fine by me!\pI get to stop pretending to be nice."),format("How… How could a couple of failed experiments beat me?"),"NULL",AfterBattle_Test)
					case 24:
						setobjectxyperm(1, 24, 21)
						addobject(1)
						speakername("???")
						msgbox(format("Where do you think you're going?"))
						closemessage
						applymovement(1, moves(walk_faster_down*5 walk_faster_right walk_faster_down*2 walk_faster_left face_up emote_exclamation_mark))
						waitmovement(1)
						playse(SE_PIN)
						waitse
						speakername("Grunt 1")
						msgbox(format("Hey, you're the lab escapees!\p
						Easy, now.\n
						Just come with us, and we won't hurt you, alright?\p
						Not any more than necessary, at least."))
						setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
						addobject(LOCALID_VEE)
						applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerWest)
						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_left))
						waitmovement(LOCALID_VEE)
						speakername("Vee")
						playse(SE_PIN)
						msgbox(format(
							"N-no… They found us!\n
							T-there's no way to run!\p
							S-seel, I…\n
							I don't wanna go back in there, but…\p
							I don't want to fight either!\n
							I really don't!\p
							But…\n
							We need to.\p
							If it's with you… I can do it!\p
							Let's show them, Seel!\n
							We're not just failed experiments!"))
						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_down))
						applymovement(LOCALID_VEE,moves(walk_in_place_down))
						waitmovement(OBJ_EVENT_ID_PLAYER)
						delay(40)
						speakername("Grunt 1")
						trainerbattle_double(TRAINER_MAGA_GRUNT_VOLTBROOK_TOWN, format(
							"Hard way it is, then. Fine by me!\pI get to stop pretending to be nice."),format("How… How could a couple of failed experiments beat me?"),"NULL",AfterBattle_Test)
					case 25:
						setobjectxyperm(1, 24, 21)
						addobject(1)
						speakername("???")
						msgbox(format("Where do you think you're going?"))
						closemessage
						applymovement(1, moves(walk_faster_down*7 walk_faster_right face_up emote_exclamation_mark))
						waitmovement(1)
						playse(SE_PIN)
						waitse
						speakername("Grunt 1")
						msgbox(format("Hey, you're the lab escapees!\p
						Easy, now.\n
						Just come with us, and we won't hurt you, alright?\p
						Not any more than necessary, at least."))
						setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
						addobject(LOCALID_VEE)
						applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerWest)
						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_left))
						waitmovement(LOCALID_VEE)
						speakername("Vee")
						playse(SE_PIN)
						msgbox(format(
							"N-no… They found us!\n
							T-there's no way to run!\p
							S-seel, I…\n
							I don't wanna go back in there, but…\p
							I don't want to fight either!\n
							I really don't!\p
							But…\n
							We need to.\p
							If it's with you… I can do it!\p
							Let's show them, Seel!\n
							We're not just failed experiments!"))
						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_down))
						applymovement(LOCALID_VEE,moves(walk_in_place_down))
						waitmovement(OBJ_EVENT_ID_PLAYER)
						speakername(NULL)
						delay(40)
						speakername("Grunt 1")
						trainerbattle_double(TRAINER_MAGA_GRUNT_VOLTBROOK_TOWN, format(
							"Hard way it is, then. Fine by me!\pI get to stop pretending to be nice."),format("How… How could a couple of failed experiments beat me?"),"NULL",AfterBattle_Test)
				}
}


script AfterBattle_Test

{
				switch(var(PlayerXCoordinates))
					{
						case 22:
							applymovement(OBJ_EVENT_ID_PLAYER,(moves(walk_in_place_down)))
							removeobject(2)
							removeobject(3)
							removeobject(2)
							setobjectxyperm(3, PlayerXCoordinates, 21)
							setobjectxyperm(2, PlayerXCoordinates, 21)
							addobject(2)
							addobject(3)
							applymovement(2, moves(walk_right))
							waitmovement(2)
							applymovement(2, moves(walk_down*5))
							applymovement(3, moves(walk_down*5))
							waitmovement(2)
							applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_up emote_exclamation_mark))
							applymovement(LOCALID_VEE,moves(walk_in_place_up emote_exclamation_mark))
							playse(SE_PIN)
							waitmovement(LOCALID_VEE)
							speakername("Grunt 2")
							msgbox(format("Get a load of this guy.\p
							What's up with you?\n
							Having trouble with these freaks?"))
							speakername("Grunt 3")
							msgbox(format("Orders are clear: capture them alive.\pNo more mistakes."))
							applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_down))
							applymovement(LOCALID_VEE,moves(walk_in_place_down))
							waitmovement(LOCALID_VEE)
							speakername("Grunt 1")
							msgbox(format("You're not getting away this time!"))
							applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_right))
							applymovement(LOCALID_VEE,moves(walk_in_place_left))
							waitmovement(LOCALID_VEE)
							speakername("Vee")
							msgbox(format("There’s three of them now…!"))
							msgbox(format("I-I don’t think we can win this…!"))
							delay(40)
							setobjectxyperm(LOCALID_FRO, 29, 22)
							addobject(LOCALID_FRO)
							applymovement(LOCALID_FRO,moves(walk_faster_down*5 walk_faster_left*5))
							waitmovement(LOCALID_FRO)
							applymovement(LOCALID_VEE,moves(walk_in_place_right))
							waitmovement(OBJ_EVENT_ID_PLAYER)
							speakername("???")
							msgbox(format("Out of the pan, into the fire.\pStick close to me if you want to live."))
							speakername("Vee")
							msgbox(format("W-Wait what do you me-"))
							playse(SE_M_SURF)
							fadescreen(FADE_TO_WHITE)
							speakername("???")
							msgbox(format("Quickly. This way!"))
							speakername("Vee")
							msgbox(format("Okay okay, we're coming!"))
							closemessage
							delay(40)
							applymovement(LOCALID_FRO, moves(walk_faster_down*7 walk_faster_left*2 face_down))
							applymovement(LOCALID_VEE, moves(walk_faster_down*8 face_up))
							applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_faster_down*8 walk_in_place_up))
							delay(80)			
							fadescreen(FADE_FROM_WHITE)
							speakername("Vee")
							msgbox(format("Geez, that was close!\n 
							I thought we were done for.\p
							Thank you so much for saving us!\n
							What's your name?"))
							speakername("???")
							msgbox(format("I'm Fro."))
							speakername("Vee")
							msgbox(format(
								"Nice to meet you, Fro!\p
								I'm Vee!\n
								And this is Seel!"
							))
							speakername("Fro")
							msgbox(format(
								"Seel?\n
								That's funny.\p
								Wait, aren't you…"
							))
							playse(SE_PIN)
							applymovement(LOCALID_FRO, moves(emote_exclamation_mark))
							waitmovement(0)
							waitse
							speakername("Fro")
							msgbox(format(
								"Hold on for a moment.\n
								I need to think."
							))
							closemessage
							applymovement(LOCALID_FRO, moves(
								walk_up
							))
							waitmovement(0)
							delay(120)
							speakername("Vee")
							msgbox(format(
								"Can we…"
							))
							speakername("Fro")
							msgbox(format(
								"Shh!\n
								I'm thinking."
							))
							closemessage
							delay(120)
							applymovement(LOCALID_FRO, moves(
								walk_down
							))
							waitmovement(0)
							speakername("Fro")
							msgbox(format(
								"Ok.\p
								It's YOU, isn't it, Seel?\p
								And that Dewgong I fought back then…\n
								That was you as well."
							))
							speakername("Vee")
							msgbox(format(
								"You two KNOW each other?"
							))
							speakername("Fro")
							msgbox(format(
								"Oh, yes, we do.\p
								I was looking for him, in fact.\n
								He went missing for a while.\p
								And now…\n
								I guess I found him."
							))
							speakername("Vee")
							msgbox(format(
								"Yippee!\n
								Mission complete!"
							))
							speakername("Fro")
							msgbox(format(
								"…And you said you were…?"
							))
							speakername("Vee")
							msgbox(format(
								"Vee the Eevee!\n
								From the lab!"
							))
							speakername("Fro")
							msgbox(format(
								"Hmm…\n
								So, you aren't a human."
							))
							playse(SE_PIN)
							applymovement(LOCALID_VEE, moves(emote_exclamation_mark))
							waitmovement(0)
							waitse
							speakername("Vee")
							msgbox(format(
								"Wait.\n
								Ohmygosh.\p
								Are you a human too?"
							))
							speakername("Fro")
							msgbox(format(
								"Me?\n
								Sure am.\l
								Or rather, was.\p
								You're speaking to the former Champion of the region, in fact."
							))
							speakername("Vee")
							msgbox(format(
								"Ohmygosh.\n
								No way! That's so cool!\p
								…What's a Champion?\n
								Is it like a Guardian?"
							))
							speakername("Fro")
							msgbox(format(
								"I have no idea what you're talking about."
							))
							msgbox(format(
								"Anyway, Seel.\n
								They got us both, in the end.\p
								I was investigating the rumors of trainers being kidnapped, but this…\p
								This project Team MAGA is pursuing is beyond anything I imagined.\p
								I could not protect you, Seel.\n
								I could not even protect myself.\p
								And now…\n
								We are all going to be stuck like this.\p
								At least, you managed to escape."
							))
							speakername("Vee")
							msgbox(format(
								"Don't be sad!\n
								We know of a way to turn you back!"
							))
							playse(SE_PIN)
							applymovement(LOCALID_FRO, moves(emote_question_mark))
							waitmovement(0)
							waitse
							speakername("Fro")
							msgbox(format("Do you, now?"))
							speakername("Vee")
							msgbox(format(
								"Yeah!\n
								We gotta find the eight Artifacts!\p
								There should be one in Voltbrook Town, actually!"
							))
							speakername("Fro")
							msgbox(format(
								"Right.\n
								The eight magical artifacts.\p
								Then we're gonna hold hands and sing and turn back to humans.\p
								Listen, Seel, I'm very happy to see you again.\p
								But you need to stop playing fantasy games, and hide.\p
								I, meanwhile, need to go back to work."
							))
							speakername("Vee")
							msgbox(format("Work?"))
							speakername("Fro")
							msgbox(format(
								"Yes.\p
								They tried to get me to fight for them, but I refused their commands.\p
								So, now…"
							))
							speakername("Vee")
							msgbox(format(
								"They're forcing you to run in a big wheel to generate electricity?"
							))
							speakername("Fro")
							msgbox(format(
								"They…\n
								Tried that.\p
								But I don't run very far.\p
								But, I have found a new calling.\p
								Thanks to my transformation, my senses of taste and smell have magnified.\p
								So now, I am a chef.\n
								And I'm also late for work.\p
								So let me give you a piece of cake.\n
								A mean, of advice.\p
								South of here, there is a town called Moonthistle.\p
								It's a town where Pokémon fleeing from Team MAGA take refuge.\p
								You will be safe there."
							))
							speakername("Vee")
							msgbox(format(
								"Thank you, Fro.\p
								But… What about you?\p
								Won't they be mad because you've helped us?"
							))
							speakername("Fro")
							msgbox(format(
								"Oh, they will.\n
								But they won't be doing anything to me.\p
								Because…"
							))
							closemessage
							applymovement(LOCALID_FRO, moves(walk_up))
							waitmovement(0)
							delay(30)
							speakername("Fro")
							msgbox(format("…They like my cooking too much."))
							closemessage
							applymovement(LOCALID_FRO,moves(walk_faster_up*10))
							waitmovement(LOCALID_FRO)
							removeobject(LOCALID_FRO)
							applymovement(LOCALID_VEE, moves(face_left))
							applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_right))
							waitmovement(0)
							speakername("Vee")
							msgbox(format("He seems nice!\n
							I hope we meet him again.\p
							For now, though, we should be away from Voltbrook.\p
							Let's check out Moonthistle!"))
							applymovement(LOCALID_VEE,Common_Movement_PartyMemberReturnsToPlayerEast)
							waitmovement(LOCALID_VEE)
							removeobject(LOCALID_VEE)
							release
							end	
						case 23:
							applymovement(OBJ_EVENT_ID_PLAYER,(moves(walk_in_place_down)))
							removeobject(2)
							removeobject(3)
							removeobject(2)
							setobjectxyperm(3, PlayerXCoordinates, 21)
							setobjectxyperm(2, PlayerXCoordinates, 21)
							addobject(2)
							addobject(3)
							applymovement(2, moves(walk_right))
							waitmovement(2)
							applymovement(2, moves(walk_down*5))
							applymovement(3, moves(walk_down*5))
							waitmovement(2)
							applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_up emote_exclamation_mark))
							applymovement(LOCALID_VEE,moves(walk_in_place_up emote_exclamation_mark))
							playse(SE_PIN)
							waitmovement(LOCALID_VEE)
							speakername("Grunt 2")
							msgbox(format("Get a load of this guy.\p
							What's up with you?\n
							Having trouble with these freaks?"))
							speakername("Grunt 3")
							msgbox(format("Orders are clear: capture them alive.\pNo more mistakes."))
							applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_down))
							applymovement(LOCALID_VEE,moves(walk_in_place_down))
							waitmovement(LOCALID_VEE)
							speakername("Grunt 1")
							msgbox(format("You're not getting away this time!"))
							applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_right))
