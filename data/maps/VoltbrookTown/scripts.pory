						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_left))
						waitmovement(LOCALID_VEE)
						speakername("Vee")
						playse(SE_PIN)
						msgbox(format("N-no… he found us! He's blocking our path-we can’t run!\pI-I don’t wanna go back to the lab! I can’t! We have to fight.\pEven if we’re scared-we have to! Let’s show them we’re not just test subjects anymore!"))
						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_down))
						applymovement(LOCALID_VEE,moves(walk_in_place_down))
						waitmovement(OBJ_EVENT_ID_PLAYER)
						delay(40)
						trainerbattle_double(TRAINER_MAGA_GRUNT_VOLTBROOK_TOWN, format("So you wanna do this the hard when then, huh? That's fine, this way is more fun for me!"),format("How could a couple of failed experiments best me?"),"NULL",AfterBattle_Test)
				}
}

script AfterBattle_Test

{
				switch(var(PlayerXCoordinates))
					{
						case 22:
							applymovement(OBJ_EVENT_ID_PLAYER,(moves(walk_in_place_down)))
							removeobject(2)
							removeobject(3)
							removeobject(2)
							setobjectxyperm(3, PlayerXCoordinates, 21)
							setobjectxyperm(2, PlayerXCoordinates, 21)
							addobject(2)
							addobject(3)
							applymovement(2, moves(walk_right))
							waitmovement(2)
							applymovement(2, moves(walk_down*5))
							applymovement(3, moves(walk_down*5))
							waitmovement(2)
							applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_up emote_exclamation_mark))
							applymovement(LOCALID_VEE,moves(walk_in_place_up emote_exclamation_mark))
							playse(SE_PIN)
							waitmovement(LOCALID_VEE)
							speakername("Grunt 2")
							msgbox(format("Guess we showed up just in time, huh?\pRelax. We’ll clean this mess up for you."))
							speakername("Grunt 3")
							msgbox(format("Orders are clear: capture them alive. No more mistakes."))
							applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_down))
							applymovement(LOCALID_VEE,moves(walk_in_place_down))
							waitmovement(LOCALID_VEE)
							speakername("Grunt 1")
							msgbox(format("They’re not getting away again. Not this time!"))
							applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_right))
							applymovement(LOCALID_VEE,moves(walk_in_place_left))
							waitmovement(LOCALID_VEE)
							speakername("Vee")
							msgbox(format("There’s three of them now…!"))
							msgbox(format("I-I don’t think we can win this…!"))
							delay(40)
							setobjectxyperm(LOCALID_ACE, 29, 22)
							addobject(LOCALID_ACE)
							applymovement(LOCALID_ACE,moves(walk_faster_down*5 walk_faster_left*5))
							waitmovement(LOCALID_ACE)
							applymovement(LOCALID_VEE,moves(walk_in_place_right))
							waitmovement(OBJ_EVENT_ID_PLAYER)
							speakername("???")
							msgbox(format("Cornered already? This is why I work alone. Stick close to me if you want to live."))
							speakername("Vee")
							msgbox(format("W-Wait what do you me-"))
							playse(SE_M_SURF)
							fadescreen(FADE_TO_WHITE)
							speakername("???")
							msgbox(format("Quickly. This way!"))
							speakername("Vee")
							msgbox(format("Okay okay, we're coming!"))
							closemessage
							delay(40)
							applymovement(LOCALID_ACE, moves(walk_faster_down*7 walk_faster_left*2 face_down))
							applymovement(LOCALID_VEE, moves(walk_faster_down*8 face_up))
							applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_faster_down*8 walk_in_place_up))
							delay(80)			
							fadescreen(FADE_FROM_WHITE)
							speakername("Vee")
							msgbox(format("That was way too close. I thought we were done for.\pThanks for saving us back there! What's your name?"))
							speakername("???")
							msgbox(format("Don’t bother."))
							speakername("Vee")
							msgbox(format("O-Okay… still, that was really brave of you."))
							speakername("???")
							msgbox(format("Brave? No.\pI just hate seeing Team MAGA capturing those too weak to defend themselves.\pThis town isn’t safe for you. Team MAGA rounds up any wild Pokémon they see.\pYou’re lucky I was nearby. Now stay out of sight."))
							speakername("Vee")
							msgbox(format("O-Okay… but where are we?"))
							speakername("???")
							msgbox(format("I just brought you to Route 10. It's just south of Voltbrook. Team MAGA doesn't really come down here, but since you two are SO special maybe they'll make an exception. Now stay out of my way and keep your head low, I won't save you again."))
							applymovement(LOCALID_ACE,moves(walk_faster_up*10))
							waitmovement(LOCALID_ACE)
							removeobject(LOCALID_ACE)
							speakername("Vee")
							msgbox(format("He’s… not very friendly."))
							msgbox(format("But I think he just saved our lives. Let's stay away from Voltbrook for now, Maybe we should see where this route leads. There has to be someplace safe for us around here."))
							applymovement(LOCALID_VEE,Common_Movement_PartyMemberReturnsToPlayerEast)
							waitmovement(LOCALID_VEE)
							removeobject(LOCALID_VEE)
							release
							end	
						case 23:
							applymovement(OBJ_EVENT_ID_PLAYER,(moves(walk_in_place_down)))
							removeobject(2)
							removeobject(3)
							removeobject(2)
							setobjectxyperm(3, PlayerXCoordinates, 21)
							setobjectxyperm(2, PlayerXCoordinates, 21)
							addobject(2)
							addobject(3)
							applymovement(2, moves(walk_right))
							waitmovement(2)
							applymovement(2, moves(walk_down*5))
							applymovement(3, moves(walk_down*5))
							waitmovement(2)
							applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_up emote_exclamation_mark))
							applymovement(LOCALID_VEE,moves(walk_in_place_up emote_exclamation_mark))
							playse(SE_PIN)
							waitmovement(LOCALID_VEE)
							speakername("Grunt 2")
							msgbox(format("Guess we showed up just in time, huh?\pRelax. We’ll clean this mess up for you."))
							speakername("Grunt 3")
							msgbox(format("Orders are clear: capture them alive. No more mistakes."))
							applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_down))
							applymovement(LOCALID_VEE,moves(walk_in_place_down))
