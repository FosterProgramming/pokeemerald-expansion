raw `
.set LOCALID_VEE, 4
.set LOCALID_ACE, 5
.set PlayerXCoordinates, VAR_TEMP_3
.set PlayerYCoordinates, VAR_TEMP_4
`
mapscripts VoltbrookTown_MapScripts
{
	MAP_SCRIPT_ON_LOAD
	{
		setrespawn(HEAL_LOCATION_VOLTBROOK_TOWN)
        if(flag(FLAG_HINTED_AT_POWERPLANT))
			{
				setmetatile(17, 3, 0x3D2, FALSE)
			}
		// if(flag(FLAG_DEFEATED_MAGA_ELECTAVIRE))
		// {
		// 	setmetatile(7, 17, DOOR, TRUE)
		// 	setmetatile(5, 23, CENTER_DOOR, TRUE)
		// 	setmetatile(19, 25, DOOR, TRUE)
		// 	setmetatile(27, 13, DOOR, TRUE)
		// 	setmetatile(31, 17, MART_DOOR, TRUE)
		// }
		release
		end
    }
}


script Voltbrook_EventScripts_GruntPatrolChat
{
    lock
	getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
	special(SpawnCameraObject)
	if(var(PlayerYCoordinates) == 6)
		{
			applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_right*5 walk_down*4))
			waitmovement(OBJ_EVENT_ID_CAMERA)
		}
	if(var(PlayerYCoordinates) == 7)
		{
			applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_right*5 walk_down*3))
			waitmovement(OBJ_EVENT_ID_CAMERA)
		}
	if(var(PlayerYCoordinates) == 8)
		{
			applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_right*5 walk_down*2))
			waitmovement(OBJ_EVENT_ID_CAMERA)
		}
    speakername("Grunt 1")
    msgbox(format("I can't believe those lab experiments actually escaped; they were nothing but failures."))
	waitmovement(2)
    speakername("Grunt 2")
    msgbox(format("Yeah, they never stand a chance out in the real world."))
    speakername("Grunt 3")
    msgbox(format("We need to split up and ask around town; they couldn't have made it far."))
    speakername("Grunt 1")
    msgbox(format("Exactly, check every alley and market; HQ expects us to find them."))
    speakername("Grunt 2")
    msgbox(format("Let's cover the east and west sides and report back immediately."))
    speakername("Grunt 3")
    msgbox(format("Alright, I'll take the north sector; you two handle the rest."))
	closemessage
	applymovement(1,moves(walk_left*2 walk_down*8))
	applymovement(2,moves(walk_down*2 walk_right*2 walk_down*6))
	applymovement(3,moves(walk_right*10))
	waitmovement(3)
	removeobject(1)
	removeobject(2)
	removeobject(3)
	setobjectxyperm(3, 26, 8)
	setobjectxyperm(2, 25, 6)
	addobject(2)
	addobject(3)
	if(var(PlayerYCoordinates) == 6)
		{
			applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up*4 walk_left*5))
			waitmovement(OBJ_EVENT_ID_CAMERA)
		}
	if(var(PlayerYCoordinates) == 7)
		{
			applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up*3 walk_left*5))
			waitmovement(OBJ_EVENT_ID_CAMERA)
		}
	if(var(PlayerYCoordinates) == 8)
		{
			applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up*2 walk_left*5))
			waitmovement(OBJ_EVENT_ID_CAMERA)
		}
	special(RemoveCameraObject)
	setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
	addobject(LOCALID_VEE)
	applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerEast)
	playse(SE_PIN)
	applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_right))
	waitmovement(OBJ_EVENT_ID_PLAYER)
    speakername("Vee")
    msgbox(format("They’re everywhere… I can’t take two steps without spotting a MAGA grunt.\pThis place isn’t safe. Not even close.\pI thought maybe we could just… sneak around, figure things out, but…\pWe have to be careful. Really careful.\pLet’s stick close and keep our heads down, okay? We’ll find that artifact. I know we will."))
    applymovement(LOCALID_VEE, Common_Movement_PartyMemberReturnsToPlayerEast)
	waitmovement(LOCALID_VEE)
	removeobject(LOCALID_VEE)
	setvar(VAR_VOLTBROOK_TOWN_STATE, 2)
	release
    end
}

script Voltbrook_EventScripts_GruntCatchesPlayerLeaving
	{
		lock
		applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_down))
		waitmovement(OBJ_EVENT_ID_PLAYER)
		getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
			switch(var(PlayerXCoordinates))
				{
					case 22:	
						setobjectxyperm(1, 22, 21)
						addobject(1)
						speakername("???")
						msgbox(format("Hey!\pWhere do you think you're off too?"))
						closemessage
						applymovement(1, moves(walk_faster_down*5 walk_faster_right walk_faster_down*2 walk_faster_left face_up emote_exclamation_mark))
						waitmovement(1)
						playse(SE_PIN)
						waitse
						speakername("Grunt 1")
						msgbox(format("You're the failed experiments who escaped our lab!\pYou sure have caused a lot of trouble. Better make this easy, I wouldn't want to hurt you any more that necessary…"))
						setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
						addobject(LOCALID_VEE)
						applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerEast)
						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_right))
						waitmovement(LOCALID_VEE)
						speakername("Vee")
						playse(SE_PIN)
						msgbox(format("N-no… he found us! He's blocking our path-we can’t run!\pI-I don’t wanna go back to the lab! I can’t! We have to fight.\pEven if we’re scared-we have to! Let’s show them we’re not just test subjects anymore!"))
						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_down))
						applymovement(LOCALID_VEE,moves(walk_in_place_down))
						waitmovement(OBJ_EVENT_ID_PLAYER)
						delay(40)
						speakername("Grunt 1")
						trainerbattle_double(TRAINER_MAGA_GRUNT_VOLTBROOK_TOWN, format("So you wanna do this the hard when then, huh? That's fine, this way is more fun for me!"),format("How could a couple of failed experiments best me?"),"NULL",AfterBattle_Test)
					case 23:
						setobjectxyperm(1, 23, 21)
						addobject(1)
						speakername("???")
						msgbox(format("Hey!\pWhere do you think you're off too?"))
						closemessage
						applymovement(1, moves(walk_faster_down*5 walk_faster_right walk_faster_down*2 walk_faster_left face_up emote_exclamation_mark))
						waitmovement(1)
						playse(SE_PIN)
						waitse
						speakername("Grunt 1")
						msgbox(format("You're the failed experiments who escaped our lab!\pYou sure have caused a lot of trouble. Better make this easy, I wouldn't want to hurt you any more that necessary…"))
						setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
						addobject(LOCALID_VEE)
						applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerEast)
						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_right))
						waitmovement(LOCALID_VEE)
						speakername("Vee")
						playse(SE_PIN)
						msgbox(format("N-no… he found us! He's blocking our path-we can’t run!\pI-I don’t wanna go back to the lab! I can’t! We have to fight.\pEven if we’re scared-we have to! Let’s show them we’re not just test subjects anymore!"))
						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_down))
						applymovement(LOCALID_VEE,moves(walk_in_place_down))
						waitmovement(OBJ_EVENT_ID_PLAYER)
						delay(40)
						trainerbattle_double(TRAINER_MAGA_GRUNT_VOLTBROOK_TOWN, format("So you wanna do this the hard when then, huh? That's fine, this way is more fun for me!"),format("How could a couple of failed experiments best me?"),"NULL",AfterBattle_Test)
					case 24:
						setobjectxyperm(1, 24, 21)
						addobject(1)
						speakername("???")
						msgbox(format("Hey!\pWhere do you think you're off too?"))
						closemessage
						applymovement(1, moves(walk_faster_down*5 walk_faster_right walk_faster_down*2 walk_faster_left face_up emote_exclamation_mark))
						waitmovement(1)
						playse(SE_PIN)
						waitse
						speakername("Grunt 1")
						msgbox(format("You're the failed experiments who escaped our lab!\pYou sure have caused a lot of trouble. Better make this easy, I wouldn't want to hurt you any more that necessary…"))
						setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
						addobject(LOCALID_VEE)
						applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerWest)
						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_left))
						waitmovement(LOCALID_VEE)
						speakername("Vee")
						playse(SE_PIN)
						msgbox(format("N-no… he found us! He's blocking our path-we can’t run!\pI-I don’t wanna go back to the lab! I can’t! We have to fight.\pEven if we’re scared-we have to! Let’s show them we’re not just test subjects anymore!"))
						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_down))
						applymovement(LOCALID_VEE,moves(walk_in_place_down))
						waitmovement(OBJ_EVENT_ID_PLAYER)
						delay(40)
						trainerbattle_double(TRAINER_MAGA_GRUNT_VOLTBROOK_TOWN, format("So you wanna do this the hard when then, huh? That's fine, this way is more fun for me!"),format("How could a couple of failed experiments best me?"),"NULL",AfterBattle_Test)
					case 25:
						setobjectxyperm(1, 24, 21)
						addobject(1)
						speakername("???")
						msgbox(format("Hey!\pWhere do you think you're off too?"))
						closemessage
						applymovement(1, moves(walk_faster_down*7 walk_faster_right face_up emote_exclamation_mark))
						waitmovement(1)
						playse(SE_PIN)
						waitse
						speakername("Grunt 1")
						msgbox(format("You're the failed experiments who escaped our lab!\pYou sure have caused a lot of trouble. Better make this easy, I wouldn't want to hurt you any more that necessary…"))
						setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
						addobject(LOCALID_VEE)
