								Mission complete!"
							))
							speakername("Fro")
							msgbox(format(
								"…And you said you were…?"
							))
							speakername("Vee")
							msgbox(format(
								"Vee the Eevee!\n
								From the lab!"
							))
							speakername("Fro")
							msgbox(format(
								"Hmm…\n
								So, you aren't a human."
							))
							playse(SE_PIN)
							applymovement(LOCALID_VEE, moves(emote_exclamation_mark))
							waitmovement(0)
							waitse
							speakername("Vee")
							msgbox(format(
								"Wait.\n
								Ohmygosh.\p
								Are you a human too?"
							))
							speakername("Fro")
							msgbox(format(
								"Me?\n
								Sure am.\l
								Or rather, was.\p
								You're speaking to the former Champion of the region, in fact."
							))
							speakername("Vee")
							msgbox(format(
								"Ohmygosh.\n
								No way! That's so cool!\p
								…What's a Champion?\n
								Is it like a Guardian?"
							))
							speakername("Fro")
							msgbox(format(
								"I have no idea what you're talking about."
							))
							msgbox(format(
								"Anyway, Seel.\n
								They got us both, in the end.\p
								I was investigating the rumors of trainers being kidnapped, but this…\p
								This project Team MAGA is pursuing is beyond anything I imagined.\p
								I could not protect you, Seel.\n
								I could not even protect myself.\p
								And now…\n
								We are all going to be stuck like this.\p
								At least, you managed to escape."
							))
							speakername("Vee")
							msgbox(format(
								"Don't be sad!\n
								We know of a way to turn you back!"
							))
							playse(SE_PIN)
							applymovement(LOCALID_FRO, moves(emote_question_mark))
							waitmovement(0)
							waitse
							speakername("Fro")
							msgbox(format("Do you, now?"))
							speakername("Vee")
							msgbox(format(
								"Yeah!\n
								We gotta find the eight artifacts!\p
								There should be one in Voltbrook Town, actually!"
							))
							speakername("Fro")
							msgbox(format(
								"Right.\n
								The eight magical artifacts.\p
								Then we're gonna hold hands and sing and turn back to humans.\p
								Listen, Seel, I'm very happy to see you again.\p
								But you need to stop playing fantasy games, and hide.\p
								I, meanwhile, need to go back to work."
							))
							speakername("Vee")
							msgbox(format("Work?"))
							speakername("Fro")
							msgbox(format(
								"Yes.\p
								They tried to get me to fight for them, but I refused their commands.\p
								So, now…"
							))
							speakername("Vee")
							msgbox(format(
								"They're forcing you to run in a big wheel to generate electricity?"
							))
							speakername("Fro")
							msgbox(format(
								"They…\n
								Tried that.\p
								But I don't run very far.\p
								But, I have found a new calling.\p
								Thanks to my transformation, my senses of taste and smell have magnified.\p
								So now, I am a chef.\n
								And I'm also late for work.\p
								So let me give you a piece of cake.\n
								A mean, of advice.\p
								South of here, there is a town called Moonthistle.\p
								It's a town where Pokémon fleeing from Team MAGA take refuge.\p
								You will be safe there."
							))
							speakername("Vee")
							msgbox(format(
								"Thank you, Fro.\p
								But… What about you?\p
								Won't they be mad because you've helped us?"
							))
							speakername("Fro")
							msgbox(format(
								"Oh, they will.\n
								But they won't be doing anything to me.\p
								Because…"
							))
							closemessage
							applymovement(LOCALID_FRO, moves(walk_up))
							waitmovement(0)
							delay(30)
							speakername("Fro")
							msgbox(format("…They like my cooking too much."))
							closemessage
							applymovement(LOCALID_FRO,moves(walk_faster_up*10))
							waitmovement(LOCALID_FRO)
							removeobject(LOCALID_FRO)
							applymovement(LOCALID_VEE, moves(face_left))
							applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_right))
							waitmovement(0)
							speakername("Vee")
							msgbox(format("He seems nice!\n
							I hope we meet him again.\p
							For now, though, we should be away from Voltbrook.\p
							Let's check out Moonthistle!"))
							applymovement(LOCALID_VEE,Common_Movement_PartyMemberReturnsToPlayerWest)
							waitmovement(LOCALID_VEE)
							removeobject(LOCALID_VEE)
							release
							end
					}
					
}

script Voltbrook_EventScripts_PreventPlayerFromReentering
	{
		lockall
		getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
		setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
		addobject(LOCALID_VEE)
		applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerNorth)
		waitmovement(LOCALID_VEE)
		msgbox(format("We need to stay away from Voltbrook for now, Seel!\n
		Let's worry about the artefact later."))
		applymovement(LOCALID_VEE, Common_Movement_PartyMemberReturnsToPlayerNorth)
		waitmovement(LOCALID_VEE)
		removeobject(LOCALID_VEE)
		applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_down))
		waitmovement(OBJ_EVENT_ID_PLAYER)
		releaseall
		end
	}

script Voltbrook_EventScripts_GruntsBlockingNorthExit
	{
		lockall
		getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
		setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
		special(SpawnCameraObject)
		applymovement(OBJ_EVENT_ID_CAMERA,moves(walk_right*4))
		waitmovement(OBJ_EVENT_ID_CAMERA)
		addobject(LOCALID_VEE)
		applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerEast)
		waitmovement(LOCALID_VEE)
		msgbox(format("We can't go this way…\nThere's MAGA grunts up ahead.\pLet's looks somewhere else."))
		applymovement(LOCALID_VEE, Common_Movement_PartyMemberReturnsToPlayerEast)
		waitmovement(LOCALID_VEE)
		removeobject(LOCALID_VEE)
		applymovement(OBJ_EVENT_ID_CAMERA,moves(walk_left*4))
		waitmovement(OBJ_EVENT_ID_CAMERA)
		special(RemoveCameraObject)
		applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_left))
		waitmovement(OBJ_EVENT_ID_PLAYER)
		releaseall
		end
	}

script Voltbrook_EventScripts_DoorsLocked
	{
		//if(!flag(FLAG_DEFEATED_MAGA_ELECTAVIRE))
		//{
		lock
		msgbox(format("The door is locked"), MSGBOX_SIGN)
		release
		//}
	}


script Voltbrook_EventScript_Locked
{
	msgbox(format("Locked."), MSGBOX_SIGN)
	end
}

script Voltbrook_EventScript_FroJoins
{
	lockall
	setvar(VAR_VOLTBROOK_PLANT_STATE, 3)
	clearflag(FLAG_SYS_HIDE_EEVEE_PARTY_MEMBER)
	addobject(LOCALID_VEE)
	clearflag(FLAG_SYS_HIDE_FRO_PARTY_MEMBER)
	addobject(LOCALID_FRO)
	setobjectxy(LOCALID_VEE, 24, 6)
	applymovement(LOCALID_VEE, moves(walk_right face_down))
	waitmovement(0)
	setobjectxy(LOCALID_FRO, 24, 12)
	applymovement(LOCALID_FRO, moves(walk_up*5))
	waitmovement(0)
	speakername("Fro")
	msgbox(format(
		"Are you two insane?\p
		No, don't answer.\n
		I got a headache.\p
		I saw an Electivire wrecking house, and Team MAGA running after it.\p
		And now I find you sneaking out of the power plant.\p
		Did you have something to do with that?"
	))
	speakername("Vee")
	msgbox(format(
		"Yup!\n
		We defeated the Guardian!"
	))
	speakername("Fro")
	msgbox(format(
		"Peachy.\n
		Very happy for you guys.\p
		Except, with Team MAGA gone from the town…\l
		I'm out of a job."
	))
	speakername("Vee")
	msgbox(format(
		"You could join me and Seel!\n
		We're going on a quest!"
	))
	speakername("Fro")
	msgbox(format(
		"Ah, yes.\n
		The quest for the magical artifacts.\p
		How's that panning out?"
	))
	speakername("Vee")
	msgbox(format(
		"We found one!"
	))
	speakername("Fro")
	msgbox(format(
		"You fo-\n
		Let me take a look.\p
		… … …\n
		… … …\p
		This…\n
		It's certainly very artifact-shaped, I will give you that."
	))
	speakername("Vee")
	msgbox(format(
		"I know, right?"
	))
	speakername("Fro")
	msgbox(format(
		"But you don't actually know how this is supposed to work, do you?"
	))
	speakername("Vee")
	msgbox(format(
		"Not really…"
	))
	speakername("Fro")
	msgbox(format(
		"Yeah.\p
		You don't know if it works, or how, just that you need eight of them.\p
		It's not that I don't trust you, Seel, but…\p
		I don't want to get my hopes up for nothing.\p
		I've been doing some thinking.\p
		I dunno about you, Seel, but I don't mind being stuck as a Pokémon."
	))
	speakername("Vee")
	msgbox(format(
		"How can you say that!\n
		Humans are so cool!"
	))
	speakername("Fro")
	msgbox(format(
		"There's some things I miss, that's true.\p
		But…\p
		I failed my responsibilites as a Champion.\l
		I couldn't protect anyone.\p
		This life as a chef…\n
		Is really not so bad.\p
		If things were like this forever, I would not mind.\p
		… … …\n
		But they won't, will they.\p
		I had it good here, but it was never going to last.\p
		And Team MAGA's still up to something.\p
		And you two…\n
		I can't just sit around and watch someone get themselves killed."
	))
	speakername("Vee")
	msgbox(format(
		"Hey!\n
		We can handle our own!\l
		We defeated a Guardian!"
	))
	speakername("Fro")
	msgbox(format(
		"Sure. Once.\n
		Can you do it again?\p
		And again, and again, and again, seven more times?"
	))
	speakername("Vee")
	msgbox(format(
		"Yeah!"
	))
	speakername("Fro")
	msgbox(format(
		"… … …\p
		Ok, guess you don't need my help, then."
	))
	speakername("Vee")
	msgbox(format(
		"No!\n
		I mean, yes!\l
		It's not what I meant!\p
		I really want you on our side, Fro!\n
		You're really cool!"
	))
	speakername("Fro")
	msgbox(format(
		"Heh.\n
		Was just messing with you.\l
		Don't worry, I'll join.\p
		I'm still not sure about the artifact business, but if my friend Seel needs help, I can't just say no."
	))
	speakername("Vee")
	msgbox(format(
		"And your friend Vee!"
	))
	speakername("Fro")
	msgbox(format(
		"…Yes, and my friend Vee."
	))
	speakername("Vee")
	msgbox(format(
		"Yayyy!"
	))
	speakername(NULL)
    playfanfare(MUS_OBTAIN_BADGE)
    msgbox(format("{COLOR RED}Fro{COLOR DARK_GRAY} has joined your team!"))
	speakername("Fro")
	msgbox(format(
		"Ok.\n
		Team MAGA's out of town for now, but there's no guarantee they won't be back.\p
		Where are we headed?"
	))
	speakername("Vee")
	msgbox(format(
		"Well…\n
		There were a bunch of places on the list we saw…\p
		I think the next one was Pyro-something."
	))
	speakername("Fro")
	msgbox(format(
		"Pyroden?\n
		It's north of Dominion City.\p
		I've heard there's some nice hot springs.\N
		I vote to go there.\p
		Since I'm larger than you two combined, my vote counts for three.\N
		Ah, I can't wait to relax in the warm water."
	))
	speakername("Vee")
	msgbox(format(
		"We're not going there to relax!\n
		We're going there to find the Artifact!"
	))
	speakername("Fro")
	msgbox(format(
		"Yes, yes.\n
		We can do both.\p
		In fact, the sooner we get there, the more spare time we'll have to relax.\p
		Lead the way, Seel."
	))
	closemessage
	applymovement(LOCALID_VEE, moves(walk_left))
	applymovement(LOCALID_FRO, moves(walk_up))
	waitmovement(0)
	removeobject(LOCALID_VEE)
	removeobject(LOCALID_FRO)
	setvar(VAR_DOMINION_CITY_LAB_INTRO_STATE, 10)
	releaseall
	end

}