raw `
.set LOCALID_VEE, 1
.set PlayerXCoordinates, VAR_TEMP_3
.set PlayerYCoordinates, VAR_TEMP_4
`

mapscripts DominionCity_MapScripts
{
	MAP_SCRIPT_ON_FRAME_TABLE 
	[
	VAR_DOMINION_CITY_LAB_INTRO_STATE, 8 
		{
				lockall
				getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
                setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
                addobject(LOCALID_VEE)
				playse(SE_PIN)
                applymovement(LOCALID_VEE, moves(walk_left emote_exclamation_mark))
				applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_left walk_in_place_left))
                waitmovement(LOCALID_VEE)
                waitse
				applymovement(LOCALID_VEE, moves(walk_left walk_down))
                waitmovement(LOCALID_VEE)
				applymovement(LOCALID_VEE, moves(face_up))
                waitmovement(LOCALID_VEE)
				delay(40)
				applymovement(LOCALID_VEE, moves(face_right emote_exclamation_mark))
                waitmovement(LOCALID_VEE)
				delay(40)
				applymovement(LOCALID_VEE, moves(walk_up walk_right))
                waitmovement(LOCALID_VEE)
                applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_left walk_in_place_left))
                speakername("Vee")
                msgbox(format("Whoa-- This is… THIS IS OUTSIDE?! The sky--it's HUGE! And the air--it's all… fresh and stuff! I thought fresh air was just a myth!\pOkaaay, okay, focus! We're not safe yet! Still fences… still gotta find a way out before--\pWait, do you hear that? No alarms. No buzzing doors. No heavy boots stomping around… Just… wind. And… birds? Huh.\pOkay, no time to get distracted--gotta keep moving before Team MAGA figures out we're gone! C'mon, let's find a way outta here--fast!"))
				applymovement(LOCALID_VEE, Common_Movement_PartyMemberReturnsToPlayerWest)
                waitmovement(LOCALID_VEE)
                removeobject(LOCALID_VEE)
                setvar(VAR_DOMINION_CITY_LAB_INTRO_STATE, 9)
                setrespawn(HEAL_LOCATION_DOMINION_CITY)
                releaseall
                end
		}
	]
}

script DominionCity_EventScripts_WhatIsThisPlace
    {
        lockall
        getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
        setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
        addobject(LOCALID_VEE)
        applymovement(LOCALID_VEE, moves(walk_fast_up * 3 walk_faster_up * 4))
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up * 5))
        waitmovement(OBJ_EVENT_ID_PLAYER)
        playse(SE_PIN)
        applymovement(LOCALID_VEE, moves(emote_question_mark walk_left * 3 face_up))
        waitmovement(LOCALID_VEE)
        delay(40)
        applymovement(LOCALID_VEE, moves(walk_right * 5 face_up))
        waitmovement(LOCALID_VEE)
        delay(40)
        applymovement(LOCALID_VEE, moves(walk_left * 2 walk_down))
        waitmovement(LOCALID_VEE)
        speakername("Vee")
        msgbox(format("Huh? What is this place?\pIt's like a town, but… where is everyone?\pEvery building looks empty…\pThis is really weird, {PLAYER}.\pWait a second… why would Team MAGA have a whole lab here?\pIn a town with no people? That makes no sense."))
        applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark))
        waitmovement(OBJ_EVENT_ID_PLAYER)
        speakername("Vee")
        msgbox(format("…Oh. Yeah. I guess if you were gonna do a bunch of creepy experiments, you'd wanna do it somewhere private.\pStill, this place gives me the creeps. Let's get out of here."))
        applymovement(LOCALID_VEE, moves(walk_down))
        waitmovement(LOCALID_VEE)
        removeobject( LOCALID_VEE)
        setvar(VAR_DOMINION_CITY_LAB_INTRO_STATE, 10)
        releaseall
        end
    }

script DominionCity_EventScripts_GruntsWestStillLooking
    {
        if(flag(FLAG_TEMP_1))
        {
            lockall
            getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
            setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
            addobject(LOCALID_VEE)
            applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerNorth)
            applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_up))
            waitmovement(OBJ_EVENT_ID_PLAYER)
            playse(SE_PIN)
            speakername("Vee")
            msgbox(format("There has to be another way around."), MSGBOX_NPC)
            applymovement(LOCALID_VEE, Common_Movement_PartyMemberReturnsToPlayerNorth)
            waitmovement(LOCALID_VEE)
            removeobject(LOCALID_VEE)
            applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right))
            waitmovement(OBJ_EVENT_ID_PLAYER)
            setflag(FLAG_TEMP_1)
            releaseall
            end 
        }
        else
        {
            lockall
            special(SpawnCameraObject)
            applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_left * 3))
            waitmovement(OBJ_EVENT_ID_CAMERA)
            playse(SE_PIN)
            applymovement(2, moves(emote_question_mark))
            waitmovement(2)
            speakername("Grunt 1")
            msgbox(format("You hear the alert? Those two test subjects escaped."))
            playse(SE_PIN)
            applymovement(3,moves(emote_exclamation_mark))
            waitmovement(3)
            speakername("Grunt 2")
            msgbox(format("One of 'em’s a Dewgong-lookin' thing. The other’s some runaway fox."))
            playse(SE_PIN)
            applymovement(2,moves(emote_exclamation_mark))
            waitmovement(2)
            speakername("Grunt 1")
            msgbox(format("Heh. Shouldn’t be hard to spot. Bet they’re hiding like scared Rattata."))
            applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_right * 3))
            waitmovement(OBJ_EVENT_ID_CAMERA)
            special(RemoveCameraObject)
            getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
            setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
            addobject(LOCALID_VEE)
            applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerNorth)
            applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_up))
            waitmovement(OBJ_EVENT_ID_PLAYER)
            playse(SE_PIN)
            speakername("Vee")
            msgbox(format("Those grunts are everywhere…\nWe can’t let them see us. If they catch us again…\pI-I’m not going back to that lab. No way. No matter what. There has to be another way around."), MSGBOX_NPC)
            applymovement(LOCALID_VEE, Common_Movement_PartyMemberReturnsToPlayerNorth)
            waitmovement(LOCALID_VEE)
            removeobject(LOCALID_VEE)
            applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right))
            waitmovement(OBJ_EVENT_ID_PLAYER)
            setflag(FLAG_TEMP_1)
            releaseall
            end
        }
    }

script DominionCity_EventScripts_GruntsNorthStillLooking
    {
        if(flag(FLAG_TEMP_2))
