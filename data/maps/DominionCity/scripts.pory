            speakername("Grunt 2")
            msgbox(format("They said Sector 7 was secure.\nThey always say that…"))
            playse(SE_PIN)
            applymovement(6,moves(emote_exclamation_mark))
            waitmovement(6)
            speakername("Grunt 1")
            msgbox(format("I didn’t sign up to chase mutated test subjects…"))
            applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up * 3))
            waitmovement(OBJ_EVENT_ID_CAMERA)
            special(RemoveCameraObject)
            getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
