raw `
.set LOCALID_VEE, 1
.set PlayerXCoordinates, VAR_TEMP_3
.set PlayerYCoordinates, VAR_TEMP_4
`

mapscripts DominionCity_MapScripts
{
	MAP_SCRIPT_ON_FRAME_TABLE 
	[
	VAR_DOMINION_CITY_LAB_INTRO_STATE, 7 
		{
				lockall
				getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
                setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
                addobject(LOCALID_VEE)
				playse(SE_PIN)
                applymovement(LOCALID_VEE, moves(walk_left emote_exclamation_mark))
				applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_left walk_in_place_left))
                waitmovement(LOCALID_VEE)
                waitse
				applymovement(LOCALID_VEE, moves(walk_left walk_down))
                waitmovement(LOCALID_VEE)
				applymovement(LOCALID_VEE, moves(face_up))
                waitmovement(LOCALID_VEE)
				delay(40)
				applymovement(LOCALID_VEE, moves(face_right emote_exclamation_mark))
                waitmovement(LOCALID_VEE)
				delay(40)
				applymovement(LOCALID_VEE, moves(walk_up walk_right))
                waitmovement(LOCALID_VEE)
                applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_left walk_in_place_left))
                speakername("Vee")
                msgbox(format("Whoa… {PLAYER}…\n
                This is… THE OUTSIDE?!\p
                I knew it wasn't a made up thing!\NI knew it!\p 
                There's like…\n
                A giant blue blanket over everything!\p
                And what's that!\n
                A huge ball in the sky!\p
                Does it bounce?\n
                Can I play with it?\p
                Okay, okay…\n
                Focus, Vee.\p
                We may be outside, but we still gotta find a way around these fences.\p
                Wait… Do you hear anything?\p
                … … …\n
                Yeah, me neither.\p
                But that's strange, isn't it?\p
                Where's the alarms?\n
                Where's the footsteps coming after us?\p
                Weird.\n
                Well, can't really complain about that!\p
                Let's find a way outta here, and fast!$"))
				applymovement(LOCALID_VEE, Common_Movement_PartyMemberReturnsToPlayerWest)
                waitmovement(LOCALID_VEE)
                removeobject(LOCALID_VEE)
                setvar(VAR_DOMINION_CITY_LAB_INTRO_STATE, 8)
                setrespawn(HEAL_LOCATION_DOMINION_CITY)
                releaseall
                end
		}
        VAR_DOMINION_CITY_LAB_INTRO_STATE, 10
        {
            setflag(FLAG_HIDE_DOMINION_GRUNTS)
            end
        }
        
	]
}

script DominionCity_EventScripts_WhatIsThisPlace
    {
        lockall
        getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
        setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
        addobject(LOCALID_VEE)
        applymovement(LOCALID_VEE, moves(walk_fast_up * 3 walk_faster_up * 4))
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up * 5))
        waitmovement(OBJ_EVENT_ID_PLAYER)
        playse(SE_PIN)
        applymovement(LOCALID_VEE, moves(emote_question_mark walk_left * 3 face_up))
        waitmovement(LOCALID_VEE)
        delay(40)
        applymovement(LOCALID_VEE, moves(walk_right * 5 face_up))
        waitmovement(LOCALID_VEE)
        delay(40)
        applymovement(LOCALID_VEE, moves(walk_left * 2 walk_down))
        waitmovement(LOCALID_VEE)
        speakername("Vee")
        msgbox(format("
        Huh? What is this place?\n
        Is it a town?\p
        I've never seen a town before.\n
        But from what I've heard…\p
        You'd think there'd be more, you know, townspeople in here…\p
        This is very strange, isn't it, {PLAYER}?"))
        applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark))
        waitmovement(OBJ_EVENT_ID_PLAYER)
        speakername("Vee")
        msgbox(format("
        …Oh. Yeah.\p
        I guess if you were gonna do a bunch of creepy experiments, you'd wanna do it somewhere private.\p
        Still, this place gives me the creeps.\p
        Let's get out of here!"))
        applymovement(LOCALID_VEE, moves(walk_down))
        waitmovement(LOCALID_VEE)
        removeobject( LOCALID_VEE)
        setvar(VAR_DOMINION_CITY_LAB_INTRO_STATE, 9)
        releaseall
        end
    }

script DominionCity_EventScripts_GruntsWestStillLooking
    {
        if(flag(FLAG_TEMP_1))
        {
            lockall
            getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
            setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
            addobject(LOCALID_VEE)
            applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerNorth)
            applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_up))
            waitmovement(OBJ_EVENT_ID_PLAYER)
            playse(SE_PIN)
            speakername("Vee")
            msgbox(format("
            Hmm…\n
            There's gotta be another way around."), MSGBOX_NPC)
            applymovement(LOCALID_VEE, Common_Movement_PartyMemberReturnsToPlayerNorth)
            waitmovement(LOCALID_VEE)
            removeobject(LOCALID_VEE)
            applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right))
            waitmovement(OBJ_EVENT_ID_PLAYER)
            setflag(FLAG_TEMP_1)
            releaseall
            end 
        }
        else
        {
            lockall
            special(SpawnCameraObject)
            applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_left * 3))
            waitmovement(OBJ_EVENT_ID_CAMERA)
            playse(SE_PIN)
            applymovement(2, moves(emote_question_mark))
            waitmovement(2)
            speakername("Grunt 1")
            msgbox(format("
            Those test subjects really had to go and escape.\p
            You know what they look like?"))
            playse(SE_PIN)
            applymovement(3,moves(emote_exclamation_mark))
            waitmovement(3)
            speakername("Grunt 2")
            msgbox(format("
            Ye, ye.\p
            It's that ugly-lookin's Dewgong thing and that…\N
            Fox-like creature, aye?\p
            Heard they were plannin' on gettin' rid of her, the poor sod.$"))
            playse(SE_PIN)
            applymovement(2,moves(emote_exclamation_mark))
            waitmovement(2)
            speakername("Grunt 1")
            msgbox(format("
            That's hardly our business.\p
            We were just ordered to find them, and find them we will.\p
            Shouldn't be too hard of a job, anyway.\p
            Bet they’re hiding like scared Rattata."))
            applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_right * 3))
            waitmovement(OBJ_EVENT_ID_CAMERA)
            special(RemoveCameraObject)
            getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
            setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
            addobject(LOCALID_VEE)
            applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerNorth)
            applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_up))
            waitmovement(OBJ_EVENT_ID_PLAYER)
            playse(SE_PIN)
            speakername("Vee")
            msgbox(format("
            Those grunts are everywhere…\p
            W-what did they say about…\n
            Getting rid of me…?\p
            Surely they don't mean…\p
            … … …\p
            {PLAYER}, we can't let them catch us.\p
            I'm not going back in there.\n
            Nuh-huh. No chance.\p
            C'mon, there has to be a way around!"), MSGBOX_NPC)
            applymovement(LOCALID_VEE, Common_Movement_PartyMemberReturnsToPlayerNorth)
            waitmovement(LOCALID_VEE)
            removeobject(LOCALID_VEE)
            applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right))
            waitmovement(OBJ_EVENT_ID_PLAYER)
            setflag(FLAG_TEMP_1)
            releaseall
            end
        }
    }

script DominionCity_EventScripts_GruntsNorthStillLooking
    {
        if(flag(FLAG_TEMP_2))
        {
            lockall
            getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
            setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
            addobject(LOCALID_VEE)
            applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerSouth)
            applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_down))
            waitmovement(OBJ_EVENT_ID_PLAYER)
            playse(SE_PIN)
            speakername("Vee")
            msgbox(format("
            Hmm…\n
            There's gotta be another way around."), MSGBOX_NPC)
            applymovement(LOCALID_VEE, Common_Movement_PartyMemberReturnsToPlayerSouth)
            waitmovement(LOCALID_VEE)
            removeobject(LOCALID_VEE)
            applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down))
            waitmovement(OBJ_EVENT_ID_PLAYER)
            setflag(FLAG_TEMP_2)
            releaseall
            end 
        }
        else
        {
            lockall
            special(SpawnCameraObject)
            applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up * 3))
            waitmovement(OBJ_EVENT_ID_CAMERA)
            playse(SE_PIN)
            applymovement(5, moves(emote_exclamation_mark))
            waitmovement(5)
            speakername("Grunt 1")
            msgbox(format("
            HQ is losing it, man.\n
            Said if we don’t find them soon, heads will roll."))
            playse(SE_PIN)
            applymovement(4,moves(emote_exclamation_mark))
            waitmovement(4)
            speakername("Grunt 2")
            msgbox(format("
            What kind of Pokémon breaks out of Sector 7, anyway?!\n
            This is bad… Really bad."))
            playse(SE_PIN)
            applymovement(5,moves(emote_exclamation_mark))
            waitmovement(5)
            speakername("Grunt 1")
            msgbox(format("
            Listen, if you spot anything weird, and I mean ANYTHING, report it.\p
            No way I'm taking the fall for this one."))
            applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_down * 3))
            waitmovement(OBJ_EVENT_ID_CAMERA)
            special(RemoveCameraObject)
            getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
            setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
            addobject(LOCALID_VEE)
            applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerSouth)
            applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_down))
            waitmovement(OBJ_EVENT_ID_PLAYER)
            playse(SE_PIN)
            speakername("Vee")
            msgbox(format("Those grunts are everywhere…\n
            {PLAYER}, we can't let them catch us.\p
            I'm not going back in there.\n
            Nuh-huh. No chance.\p
            C'mon, there has to be a way around!"), MSGBOX_NPC)
            applymovement(LOCALID_VEE, Common_Movement_PartyMemberReturnsToPlayerSouth)
            waitmovement(LOCALID_VEE)
            removeobject(LOCALID_VEE)
            applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down))
            waitmovement(OBJ_EVENT_ID_PLAYER)
            setflag(FLAG_TEMP_2)
            releaseall
            end
        }
    }

script DominionCity_EventScripts_GruntsSouthStillLooking
    {
        if(flag(FLAG_TEMP_3))
        {
            lockall
            getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
            setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
            addobject(LOCALID_VEE)
            applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerNorth)
            applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_up))
            waitmovement(OBJ_EVENT_ID_PLAYER)
            playse(SE_PIN)
            speakername("Vee")
