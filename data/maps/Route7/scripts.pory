raw `
.set LOCALID_VEE, 1
.set PlayerXCoordinates, VAR_TEMP_3
.set PlayerYCoordinates, VAR_TEMP_4
`

mapscripts Route7_MapScripts
{
	MAP_SCRIPT_ON_FRAME_TABLE 
	[
	VAR_VOLTBROOK_TOWN_STATE, 0 
		{
				lockall
				getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
                setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
                addobject(LOCALID_VEE)
				if(var(PlayerXCoordinates) == 2)
					{
						addobject(LOCALID_VEE)
						applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerSouth)
						applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_down))
						waitmovement(OBJ_EVENT_ID_PLAYER)
						playse(SE_PIN)
						speakername("Vee")
						msgbox(format("Wait! Over there!\nI think I saw something!\pC’mon, let’s check it out!"))
						closemessage
						applymovement(LOCALID_VEE, moves(walk_down*4 walk_right*3 walk_down*3 walk_right*2 face_up))
						applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down*5 walk_right*3 walk_down*3 walk_right walk_in_place_up))
						applymovement(LOCALID_VEE, moves(emote_exclamation_mark))
						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_right))
						playse(SE_PIN)
						waitmovement(LOCALID_VEE)
						speakername("Vee")
						msgbox(format("Oh!\n
						Hmm…\p
						Yes, yes…\n
						I see."))
						applymovement(LOCALID_VEE,moves(face_left))
						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_right))
						waitmovement(0)
						msgbox(format("…I can't read it.\n
						What's it say?"))
						closemessage
						applymovement(LOCALID_VEE,moves(face_up))
						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_up))
						waitmovement(OBJ_EVENT_ID_PLAYER)
						msgbox(format("{UP_ARROW} Dominion City\n{DOWN_ARROW}Voltbrook Town"))
						closemessage
						applymovement(LOCALID_VEE, moves(emote_question_mark face_left))
						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_right))
						waitmovement(OBJ_EVENT_ID_PLAYER)
						speakername("Vee")
						msgbox(format("Wait…\n
						The computer at the lab talked about Voltrbook Town, right?\p
						Like, one of the places that have an artifact?\p
						We need to find it!\p
						But, a Guardian might be there too.\p
						Brr…\n
						Let's try and steer clear from Team MAGA and from any Guardians, ok?"))
						closemessage
						applymovement(LOCALID_VEE, Common_Movement_PartyMemberReturnsToPlayerEast)
						waitmovement(LOCALID_VEE)
						removeobject(LOCALID_VEE)
						setvar(VAR_VOLTBROOK_TOWN_STATE, 1)
					}
				elif(var(PlayerXCoordinates) == 3)
					{
						addobject(LOCALID_VEE)
