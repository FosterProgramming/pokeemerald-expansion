						closemessage
						applymovement(LOCALID_VEE, moves(emote_question_mark face_left))
						applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_right))
						waitmovement(OBJ_EVENT_ID_PLAYER)
						speakername("Vee")
						msgbox(format("Wait…\n
