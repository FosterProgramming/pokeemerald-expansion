//FLAG_FIND_DOMINION_CITY_MAGA_LAB_SECURITY_HALLWAY_SITRUS_BERRY
script DominionCity_MagaLab_SecurityHallway_EventScript_FindSitrusBerry {
    lockall
    finditem(ITEM_SITRUS_BERRY, 1)
    releaseall
    end
}

