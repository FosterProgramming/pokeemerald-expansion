
mapscripts MountPyroden_2F_West_MapScripts
{
	MAP_SCRIPT_ON_LOAD
	{
		if(flag(FLAG_PYRODEN_MT_2F_WEST_FIRE_PIT_1) && flag(FLAG_PYRODEN_MT_2F_WEST_FIRE_PIT_2)
		&& flag(FLAG_PYRODEN_MT_2F_WEST_FIRE_PIT_3) && flag(FLAG_PYRODEN_MT_2F_WEST_FIRE_PIT_4))
		{
			call(MountPyroden_2F_West_EventScript_RemoveRocks)
		}
		end
	}
}


script MountPyroden_2F_West_EventScript_FirePit
	{
	lock
	if(flag(FLAG_WILLOWISP_ACTIVE))
	{
		if(flag(FLAG_PYRODEN_MT_2F_WEST_FIRE_PIT_1) && flag(FLAG_PYRODEN_MT_2F_WEST_FIRE_PIT_2)
		&& flag(FLAG_PYRODEN_MT_2F_WEST_FIRE_PIT_3) && flag(FLAG_PYRODEN_MT_2F_WEST_FIRE_PIT_4))
		{
			playse(SE_UNLOCK)
			call(MountPyroden_2F_West_EventScript_RemoveRocks)
			waitse
		}
		else
		{
			delay(20)
			setvar(VAR_0x8000, 1)
			callnative(SetFirePitOff)
			setvar(VAR_0x8000, 3)
			callnative(SetFirePitOff)
			setvar(VAR_0x8000, 4)
			callnative(SetFirePitOff)
			setvar(VAR_0x8000, 5)
			callnative(SetFirePitOff)
		}
		clearflag(FLAG_WILLOWISP_ACTIVE)
	}
	else{
		checkitem(ITEM_STRENGTH_TOOL)
		if(var(VAR_RESULT) == TRUE)
		{
		goto(EventScript_StrengthBoulder)
		}
	}
	release
	end
}

script MountPyroden_2F_West_EventScript_RemoveRocks
{
	setmetatile(20, 9, METATILE_MountPyroden_Floor, FALSE)
	special(DrawWholeMapView)
}