Emberglide_EventScript_Magby_Text_1:
# 39 "data/maps/Emberglide/scripts.pory"
	.string "There's not many humans around here,\n"
	.string "usually.\l"
	.string "Never really liked them, anyway.\p"
	.string "They stink. And are rude. And ugly.\n"
	.string "I'm sure you agree.$"
