raw `
VoltbrookTown_PowerPlant_LeftGeneratorRoom_2F_MapScripts::
	map_script MAP_SCRIPT_ON_FRAME_TABLE, CaveHole_CheckFallDownHole
	map_script MAP_SCRIPT_ON_TRANSITION, VoltbrookTown_PowerPlant_LeftGeneratorRoom_2F_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, VoltbrookTown_PowerPlant_LeftGeneratorRoom_2F_SetHoleWarp
	map_script MAP_SCRIPT_ON_LOAD, VoltbrookTown_PowerPlant_LeftGeneratorRoom_2F_OnLoad
	.byte 0

VoltbrookTown_PowerPlant_LeftGeneratorRoom_2F_OnTransition:
	copyvar VAR_ICE_STEP_COUNT, 1
	end


VoltbrookTown_PowerPlant_LeftGeneratorRoom_2F_SetHoleWarp:
	setstepcallback STEP_CB_CRACKED_FLOOR
	setholewarp MAP_VOLTRBOOK_TOWN_POWER_PLANT_LEFT_GENERATOR_ROOM
	end

`


script VoltbrookTown_PowerPlant_LeftGeneratorRoom_2F_OnLoad
{
	if(flag(FLAG_VOLTBROOK_PLANT_GENERATOR_2F_TRIGGERED))
	{
		call(VoltbrookTown_PowerPlant_Generator_2F_UnlockDoor)
	}
}


script VoltbrookTown_PowerPlant_Generator_2F_Switch1
{
	lockall
    if(var(VAR_TEMP_BOULDER_SWITCH_EVENT_ID_1) != BOULDER_SWITCH_NO_EVENT){
        setflag(FLAG_VOLTBROOK_PLANT_GENERATOR_2F_TRIGGERED)
        call(VoltbrookTown_PowerPlant_Generator_2F_UnlockDoor)
        playse(SE_UNLOCK)
        
    }
    else{
        clearflag(FLAG_VOLTBROOK_PLANT_GENERATOR_2F_TRIGGERED)
        call(VoltbrookTown_PowerPlant_Generator_2F_LockDoor)
        playse(SE_CLICK)
        
    }
    releaseall
    end
}

script VoltbrookTown_PowerPlant_Generator_2F_UnlockDoor
{
	setobjectxyperm(1, 14, 17)
	setmetatile(16, 11, METATILE_PowerPlant_NormalFloorNoShadow, 0)
	setmetatile(16, 12, METATILE_PowerPlant_NormalFloorLeftShadow, 0)
	special(DrawWholeMapView)
}


script VoltbrookTown_PowerPlant_Generator_2F_LockDoor
{
	setobjectxyperm(1, 14, 17)
	setmetatile(16, 11, METATILE_PowerPlant_TopBarrierNormalFloorNoShadow, 0)
	setmetatile(16, 12, METATILE_PowerPlant_BottomBarrierNormalFloorLeftShadow, 1)
	special(DrawWholeMapView)
}

script VoltbrookTown_PowerPlant_Generator_2F_TeamMagaNPC
{
    trainerbattle_double(TRAINER_GRUNT_WEATHER_INST_1, format("
    This Power Plant Gives us control of all Electricity in the Region.\p
	We are unstoppable."),format("I've been stopped."),format("INULL"),VoltbrookTown_PowerPlant_Generator_2F_PostGruntBattle)
    speakername("Grunt")
    msgbox(format("
    Boss is going to be so mad."))
    releaseall
    end
} 

script VoltbrookTown_PowerPlant_Generator_2F_PostGruntBattle
{
    speakername("Grunt")
    msgbox(format("
    Boss is going to be so mad."))
    releaseall
    end
}

script VoltbrookTown_PowerPlant_Generator_2F_TeamMagaNPC2
{
    trainerbattle_double(TRAINER_GRUNT_WEATHER_INST_2, format("
    Can you feel it in the air?\p
	Things are just smoother since Team MAGA showed up.
	Some of the workers don't appreciate our mission.\p
	That's why eventually all human workers will be replaced with Pokémon.
	You would make a fine addition to our workforce!"),format("You put me to work instead!"),format("INULL"),VoltbrookTown_PowerPlant_Generator_2F_PostGruntBattle2)
    speakername("Grunt")
    msgbox(format("
    You can knock me down, but greatness keeps moving forward."))
    releaseall
    end
} 

script VoltbrookTown_PowerPlant_Generator_2F_PostGruntBattle2
{
    speakername("Grunt")
    msgbox(format("
    You can knock me down, but greatness keeps moving forward."))
    releaseall
    end
}

script VoltbrookTown_PowerPlant_Generator_2F_PlantWorkerNPC
{
	lockall
    msgbox(format("
    H-hey…\n
	Don't mind me. Just… keeping the turbines logged…"),MSGBOX_NPC)
    releaseall
    end
}