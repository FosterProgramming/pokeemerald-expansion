raw `
.set LOCALID_VEE, 1
.set PlayerXCoordinates, VAR_TEMP_3
.set PlayerYCoordinates, VAR_TEMP_4
`

mapscripts DominionCity_MagaLab_EntranceHallway_MapScripts{
    MAP_SCRIPT_ON_FRAME_TABLE 
    [
        VAR_TEMP_0, 0
        {
        if(var(VAR_DOMINION_CITY_LAB_INTRO_STATE) == 7) 
           {
                setmetatile(25, 9, 0x2BC, FALSE)
                setmetatile(26, 9, 0x2BD, FALSE)
                setvar(VAR_TEMP_0, 1)
           }
        elif(var(VAR_DOMINION_CITY_LAB_INTRO_STATE) > 7)
            {
                setvar(VAR_TEMP_0, 1)
            }
        }
    ]
}

script DominionCity_MagaLab_EntranceHallway_EventScripts_WarpToMarioCode
        {
            lockall
            applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_down))
            waitmovement(OBJ_EVENT_ID_PLAYER)
            warpsilent(MAP_DOMINION_CITY_MAGA_LAB_EXIT_CODE, 7, 4)
            delay(40)
            lockall
        }