script DominionCity_MagaLab_ExitRoom_EventScripts_CodeToUnlockDoor
    {
        msgbox(format("The door is locked from the outside and requires a passcode to exit.\p
        Would you like to enter the passcode now?"),MSGBOX_YESNO)
        goto_if_eq(VAR_RESULT, YES, DominionCity_MagaLab_ExitRoom_EventScripts_EnterPassword)
        warpsilent(MAP_DOMINION_CITY_MAGA_LAB_ENTRANCE_HALLWAY, 25, 8)
        delay(40)
        end
        }

script DominionCity_MagaLab_ExitRoom_EventScripts_EnterPassword
    {
        special(EnterCode)
        waitstate
        comparepassword(0)
        goto_if_eq(VAR_RESULT,0,DominionCity_MagaLab_ExitRoom_EventScripts_WrongPassword)
        goto_if_eq(VAR_RESULT,1,DominionCity_MagaLab_ExitRoom_EventScripts_CorrectPassword)
    }

script DominionCity_MagaLab_ExitRoom_EventScripts_WrongPassword
{
    msgbox(format("Nothing happened. Would you like to try again?"),MSGBOX_YESNO)
    goto_if_eq(VAR_RESULT, YES, DominionCity_MagaLab_ExitRoom_EventScripts_EnterPassword)
    warpsilent(MAP_DOMINION_CITY_MAGA_LAB_ENTRANCE_HALLWAY, 25, 8)
    delay(40)
    end
}

script DominionCity_MagaLab_ExitRoom_EventScripts_CorrectPassword
{
    playse(SE_DOOR)
    waitse
    speakername("Vee")
    msgbox(format("Oooh, that's a good sound!\n 
    It looks like the door's unlocked!\p 
    …Sooo, I guess we're really doing this, huh?\p
    Eight whole artifacts to find…\p
    And eight terrifying guardians to defeat…\p
    Hey, I bet you're soo relieved that I'm coming with you!\p
    You know, for emotional support!\p
    In case you get too scared, or something!\p
    … … …\p
    Okletsjustgonow!"))
    setvar(VAR_DOMINION_CITY_LAB_INTRO_STATE, 7)
    releaseall
    warpsilent(MAP_DOMINION_CITY_MAGA_LAB_ENTRANCE_HALLWAY, 25, 8)
}