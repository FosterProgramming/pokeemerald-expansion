mapscripts DominionCity_MagaLab_ExitCode_MapScripts
    {
        MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_DOMINION_CITY_LAB_INTRO_STATE, 6 
        {
            goto(DominionCity_MagaLab_ExitRoom_EventScripts_CodeToUnlockDoor)
        }
        ]
    }

