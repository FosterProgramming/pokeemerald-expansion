raw `
.set LOCALID_EEVEE, 2
.set PlayerXCoordinates, VAR_TEMP_3
.set PlayerYCoordinates, VAR_TEMP_4
`
mapscripts DominionCity_MagaLab_Entrance_MapScripts
	{
		MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_DOMINION_CITY_LAB_INTRO_STATE, 4 
		{
            lockall
			applymovement(1, moves(emote_exclamation_mark))
			waitmovement(1)
			setvar(VAR_DOMINION_CITY_LAB_INTRO_STATE, 5)
			playse(SE_PIN)
			waitse
			playbgm(MUS_ENCOUNTER_AQUA, FALSE)
			applymovement(1, moves(walk_up * 4))
			waitmovement(1)
            msgbox(format("ANALYSIS COMPLETE. CONCLUSION: YOU ARE INFERIOR.\pI AM THE PERFECTED MODEL. YOU ARE FAILED EXPERIMENTS.\pATTEMPTING ESCAPE IS FUTILE. YOU WILL BE RECAPTURED.\pINITIATING COMBAT PROTOCOLS. PREPARE FOR TERMINATION."),MSGBOX_AUTOCLOSE)
			playmoncry(SPECIES_PORYGON, CRY_MODE_ENCOUNTER)
			delay(40)
			waitmoncry
			//setflag(FLAG_SYS_WILD_2V1)
			//setwildbattle(SPECIES_PORYGON, 25)
			//special(BattleSetup_StartPorygonBattle)
			trainerbattle_no_intro(TRAINER_ED, msgbox(format("SYSTEM DAMAGE EXCEEDS PARAMETERS. UNACCEPTABLE OUTCOME.\pYOU... YOU ARE NOT SUPERIOR... THIS IS A GLITCH.\pI WILL BE REBUILT. YOU WILL BE ERASED")))
			setvar(VAR_DOMINION_CITY_LAB_INTRO_STATE, 6)
			playmoncry(SPECIES_PORYGON, CRY_MODE_NORMAL)
			delay(40)
			waitmoncry
			applymovement(1, moves(walk_down * 7))
			waitmovement(1)
			removeobject(1)
			setflag(FLAG_HIDE_MAGA_LAB_ENTRANCE_PORYGON)
			getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
			setobjectxyperm(LOCALID_EEVEE, PlayerXCoordinates, PlayerYCoordinates)
			addobject(LOCALID_EEVEE)
			applymovement(LOCALID_EEVEE, moves(walk_down emote_exclamation_mark))
			playse(SE_PIN)
			waitmovement(LOCALID_EEVEE)
			waitse
			speakername("Vee")
			msgbox(format("HAH! That’s what you get for calling us failures!"))
			applymovement(LOCALID_EEVEE, moves(face_up))
			msgbox(format("Come on, Porygon ran through that door down there! I bet that's the way out! Let's hurry!"))
			applymovement(LOCALID_EEVEE, moves(walk_up))
			waitmovement(LOCALID_EEVEE)
			removeobject(LOCALID_EEVEE)
			closemessage
			releaseall
    		end
		}
		VAR_DOMINION_CITY_LAB_INTRO_STATE, 5 
		{
            lockall
			applymovement(1, moves(emote_exclamation_mark))
			waitmovement(1)
			playse(SE_PIN)
			waitse
			playbgm(MUS_ENCOUNTER_AQUA, FALSE)
			applymovement(1, moves(walk_up * 4))
			waitmovement(1)
            msgbox(format("ANALYSIS COMPLETE. CONCLUSION: YOU ARE INFERIOR.\pI AM THE PERFECTED MODEL. YOU ARE FAILED EXPERIMENTS.\pATTEMPTING ESCAPE IS FUTILE. YOU WILL BE RECAPTURED.\pINITIATING COMBAT PROTOCOLS. PREPARE FOR TERMINATION."),MSGBOX_AUTOCLOSE)
			playmoncry(SPECIES_PORYGON, CRY_MODE_ENCOUNTER)
			delay(40)
			waitmoncry
			setwildbattle(SPECIES_PORYGON, 25)
			dowildbattle
			msgbox(format("SYSTEM DAMAGE EXCEEDS PARAMETERS. UNACCEPTABLE OUTCOME.\pYOU... YOU ARE NOT SUPERIOR... THIS IS A GLITCH.\pI WILL BE REBUILT. YOU WILL BE ERASED"))
			setvar(VAR_DOMINION_CITY_LAB_INTRO_STATE, 6)
			playmoncry(SPECIES_PORYGON, CRY_MODE_NORMAL)
			delay(40)
			waitmoncry
			applymovement(1, moves(walk_down * 7))
			waitmovement(1)
			removeobject(1)
			setflag(FLAG_HIDE_MAGA_LAB_ENTRANCE_PORYGON)
			getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
			setobjectxyperm(LOCALID_EEVEE, PlayerXCoordinates, PlayerYCoordinates)
			addobject(LOCALID_EEVEE)
			applymovement(LOCALID_EEVEE, moves(walk_down emote_exclamation_mark))
			playse(SE_PIN)
			waitmovement(LOCALID_EEVEE)
			waitse
			speakername("Vee")
			msgbox(format("HAH! That’s what you get for calling us failures!"))
			applymovement(LOCALID_EEVEE, moves(face_up))
			msgbox(format("Come on, Porygon ran through that door down there! I bet that's the way out! Let's hurry!"))
			applymovement(LOCALID_EEVEE, moves(walk_up))
			waitmovement(LOCALID_EEVEE)
			removeobject(LOCALID_EEVEE)
			closemessage
			releaseall
    		end
		}
    ]
	}

script DominionCity_MagaLab_Entrance_EventScripts_TriggerTitleScreenCutscene
{
	lockall
	setvar(VAR_DOMINION_CITY_LAB_INTRO_STATE, 7)
	special(SaveGame)
	waitstate
	while (var(VAR_RESULT) != 1) 
				{
					special(SaveGame)
					waitstate
   				}
	fadeoutbgm(0)
	delay(40)
	fadescreenspeed(FADE_TO_WHITE, 4)
}