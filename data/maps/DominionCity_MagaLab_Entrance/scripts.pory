raw `
.set LOCALID_VEE, 2
.set PlayerXCoordinates, VAR_TEMP_3
.set PlayerYCoordinates, VAR_TEMP_4
`
mapscripts DominionCity_MagaLab_Entrance_MapScripts
	{
		MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_DOMINION_CITY_LAB_INTRO_STATE, 4 
		{
            lockall
			applymovement(1, moves(emote_exclamation_mark))
			waitmovement(1)
			setvar(VAR_DOMINION_CITY_LAB_INTRO_STATE, 5)
			playse(SE_PIN)
			waitse
			playbgm(MUS_ENCOUNTER_AQUA, FALSE)
			applymovement(1, moves(walk_up * 4))
			waitmovement(1)
            msgbox(format("
			SCANNING…\n
			SCANNING…\p
			ANALYSIS COMPLETE.\n
			INFERIOR LIFEFORMS IDENTIFIED.\p
			CONCLUSION: ESCAPE IS FUTILE.\n
			VICTORY IS FOREGONE.\p
			COMBAT MODE: ENGAGED.\p
			PLEASE SIT STILL AND PREPARE FOR THE TERMINATION PROTOCOL."),MSGBOX_AUTOCLOSE)
			playmoncry(SPECIES_PORYGON, CRY_MODE_ENCOUNTER)
			delay(40)
			waitmoncry
			setvar(VAR_ENEMY_1_ABILITY_OVERWRITE_1, ABILITY_MOODY)       //Sets a custom ability to the enemy 1
			setvar(VAR_ENEMY_1_ABILITY_OVERWRITE_2, ABILITY_DOWNLOAD)    //Sets a custom innate to the enemy 1 in the slot 1
			setvar(VAR_ENEMY_1_ABILITY_OVERWRITE_3, ABILITY_DOWNLOAD)    //Sets a custom ability to the enemy in the slot 2
			setvar(VAR_ENEMY_1_ABILITY_OVERWRITE_4, ABILITY_RUN_AWAY)    //Sets a custom innate to the enemy 1 in the slot 3
			setvar(VAR_ENEMY_1_CUSTOM_MAX_HP, 80)                        //Sets custom HP to the enemy 1
			setflag(FLAG_SYS_SMART_WILD_AI)                              //Forces the wild Pokémon to have an smart AI
			//setflag(FLAG_FORCE_DOUBLE_WILD_BATTLE)                     //Forces a double battle vs 1 enemy
			setvar(VAR_BOSS_BRAVE_AI_ID, BRAVE_BOSS_PORYGON)             //Sets custom HP to the enemy 1

			playmoncry(SPECIES_PORYGON, 2,)
			setwildbossbattle(SPECIES_PORYGON, 2, ITEM_NONE, NATURE_ADAMANT, MOVE_THUNDERSHOCK, MOVE_TACKLE, MOVE_RECOVER, MOVE_PSYBEAM, 6, 252, 0, 0, 0, 252)
			setflag(FLAG_SYS_CTRL_OBJ_DELETE)
			dowildbattle
			clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
			setvar(VAR_BOSS_BRAVE_AI_ID, BRAVE_BOSS_NONE)  
			specialvar(VAR_RESULT, GetBattleOutcome)
			setvar(VAR_DOMINION_CITY_LAB_INTRO_STATE, 6)
			msgbox(format(			
			"WARNING.\n
			WARNING.\p
			SYSTEM DAMAGE EXCEEDS ACCEPTABLE THRESHOLD.\p
			ERROR: INITIAL ANALYSIS WAS ERRONEOUS.\p
			NO.\n
			IMPOSSIBLE.\p
			RECALIBRATE.\n
			RECALIBRATE.\p
			YOU… ARE INFERIOR…\n
			YOU… WILL BE ERASED…\l
			I… WILL BE… REBUILT…"))
			playmoncry(SPECIES_PORYGON, CRY_MODE_NORMAL)
			delay(40)
			waitmoncry
			applymovement(1, moves(walk_down * 7))
			waitmovement(1)
			removeobject(1)
			setflag(FLAG_HIDE_MAGA_LAB_ENTRANCE_PORYGON)
			getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
			setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
			addobject(LOCALID_VEE)
			applymovement(LOCALID_VEE, moves(walk_down emote_exclamation_mark))
			playse(SE_PIN)
			waitmovement(LOCALID_VEE)
			waitse
			speakername("Vee")
			msgbox(format(
			"Hah!\n
			How's that for inferior lifeforms?"))
			applymovement(LOCALID_VEE, moves(face_up))
			msgbox(format("
			Come on, that Porygon went that way!\p
			I bet that's the way out!"))
			applymovement(LOCALID_VEE, moves(walk_up))
			waitmovement(LOCALID_VEE)
			removeobject(LOCALID_VEE)
			closemessage
			releaseall
    		end
		}
		VAR_DOMINION_CITY_LAB_INTRO_STATE, 5 
		{
            lockall
			applymovement(1, moves(emote_exclamation_mark))
			waitmovement(1)
			playse(SE_PIN)
			waitse
			playbgm(MUS_ENCOUNTER_AQUA, FALSE)
			applymovement(1, moves(walk_up * 4))
			waitmovement(1)
            msgbox(format("
			SCANNING…\n
			SCANNING…\p
			ANALYSIS COMPLETE.\n
			INFERIOR LIFEFORMS IDENTIFIED.\p
			CONCLUSION: ESCAPE IS FUTILE.\n
			VICTORY IS FOREGONE.\p
			COMBAT MODE: ENGAGED.\p
			PLEASE SIT STILL AND PREPARE FOR THE TERMINATION PROTOCOL."),MSGBOX_AUTOCLOSE)
			playmoncry(SPECIES_PORYGON, CRY_MODE_ENCOUNTER)
			delay(40)
			waitmoncry
			setwildbattle(SPECIES_PORYGON, 25)
			dowildbattle
			msgbox(format(			
			"WARNING.\n
			WARNING.\p
			SYSTEM DAMAGE EXCEEDS ACCEPTABLE THRESHOLD.\p
			ERROR: INITIAL ANALYSIS WAS ERRONEOUS.\p
			NO.\n
			IMPOSSIBLE.\p
			RECALIBRATE.\n
			RECALIBRATE.\p
			YOU… ARE INFERIOR…\n
			YOU… WILL BE ERASED…\l
			I… WILL BE… REBUILT…"))
			setvar(VAR_DOMINION_CITY_LAB_INTRO_STATE, 6)
			playmoncry(SPECIES_PORYGON, CRY_MODE_NORMAL)
			delay(40)
			waitmoncry
			applymovement(1, moves(walk_down * 7))
			waitmovement(1)
			removeobject(1)
			setflag(FLAG_HIDE_MAGA_LAB_ENTRANCE_PORYGON)
			getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
			setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
			addobject(LOCALID_VEE)
			applymovement(LOCALID_VEE, moves(walk_down emote_exclamation_mark))
			playse(SE_PIN)
			waitmovement(LOCALID_VEE)
			waitse
			speakername("Vee")
			msgbox(format(
			"Hah!\n
			How's that for inferior lifeforms?"))
			applymovement(LOCALID_VEE, moves(face_up))
			msgbox(format("
			Come on, that Porygon went that way!\p
			I bet that's the way out!"))
			applymovement(LOCALID_VEE, moves(walk_up))
			waitmovement(LOCALID_VEE)
			removeobject(LOCALID_VEE)
			closemessage
			releaseall
    		end
		}
    ]
	}
