mapscripts MountPyroden_2F_South_MapScripts
{
	MAP_SCRIPT_ON_LOAD
	{
		if(flag(FLAG_PYRODEN_MT_2F_SOUTH_FIRE_PIT_1) && flag(FLAG_PYRODEN_MT_2F_SOUTH_FIRE_PIT_2) && flag(FLAG_PYRODEN_MT_2F_SOUTH_FIRE_PIT_3))
		{
			call(MountPyroden_2F_South_EventScript_SpawnStairs)
		}
		end
	}
}

script MountPyroden_2F_South_EventScript_FirePit
{
	lock
	if(flag(FLAG_WILLOWISP_ACTIVE))
	{
		if(flag(FLAG_PYRODEN_MT_2F_SOUTH_FIRE_PIT_1) && flag(FLAG_PYRODEN_MT_2F_SOUTH_FIRE_PIT_2) && flag(FLAG_PYRODEN_MT_2F_SOUTH_FIRE_PIT_3))
		{
			playse(SE_UNLOCK)
			call(MountPyroden_2F_South_EventScript_SpawnStairs)
			waitse
		}
		else
		{
			delay(20)
			setvar(VAR_0x8000, 1)
			callnative(SetFirePitOff)
			setvar(VAR_0x8000, 2)
			callnative(SetFirePitOff)
			setvar(VAR_0x8000, 3)
			callnative(SetFirePitOff)
		}
		clearflag(FLAG_WILLOWISP_ACTIVE)
	}
	else{
		checkitem(ITEM_STRENGTH_TOOL)
		if(var(VAR_RESULT) == TRUE)
		{
		goto(EventScript_StrengthBoulder)
		}
	}
	release
	end
}

script MountPyroden_2F_South_EventScript_SpawnStairs{
	setmetatile(35, 30, METATILE_MountPyroden_Stairs_Left_Top, FALSE)
	setmetatile(35, 31, METATILE_MountPyroden_Stairs_Left_Bottom, FALSE)
	special(DrawWholeMapView)
	return
}