script MurkwellBog_PsychicHouse_EventScripts_PsychicNPC_TalonParty
    {
        lock
        msgbox(format("The winds shift, the stars murmur…\pShadows of fate coil around you.\pI see many paths, many truths… and yet only one destiny.\pTell me, traveler… whose soul do you wish for me to peer into?"))
        dynmultichoice(0,0,FALSE,3,0,DYN_MULTICHOICE_CB_NONE,"Seel","Vee","Talon")
            switch(var(VAR_RESULT))
                {
                    case 0:
                        msgbox(format("A frozen tide, bound by the will of the past…\pI see a veil of frost, an eternal barrier between pain and peace.\pThe guardian of the deep must embrace the stillness of time to reclaim what was lost."))
                    case 1:
                        msgbox(format("A soul untethered, a fate unwritten…\pI see shifting forms, flickering like candlelight in the wind.\pTo awaken the slumbering heart, you must embrace the many paths before you. Only then will you find your true self."))
                    case 2:
                        msgbox(format("A hunter with three eyes, yet only one vision…\pI see a piercing force, striking faster than the mind can comprehend.\pTo shatter the sky, you must abandon hesitation--your greatest weapon is not speed, but intent."))
                }
        release
        end
    }

