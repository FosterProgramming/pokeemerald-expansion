raw `
.set LOCALID_VEE, 1
.set PlayerXCoordinates, VAR_TEMP_3
.set PlayerYCoordinates, VAR_TEMP_4
DominionCity_MagaLab_ResearchWing_MapScripts::
	.byte 0
`
script DominionCity_MagaLab_ResearchWing_EventScript_PlayerFindsBookmark
{
	if(var(VAR_DOMINION_CITY_LAB_INTRO_STATE) < 2)
		{
			msgbox(format("A book with lots and lots of hard to read research notes.\p
			…Oh!\n
			The bookmark contains a password!\p
			Maybe it unlocks something important."),MSGBOX_SIGN)
			setvar(VAR_DOMINION_CITY_LAB_INTRO_STATE, 2)
			releaseall
			end
		}
	else
		{
			msgbox(format("A book with lots and lots of hard to read research notes."))
			releaseall
			end
		}
}

script DominionCity_MagaLab_ResearchWing_EventScript_Terminal
{
	lockall
	if(var(VAR_DOMINION_CITY_LAB_INTRO_STATE) < 2)
		{
			msgbox(format(
			"The terminal is locked.\n
			Someone put a sticky note on it.\p
			“From this week onwards, password reset requests will be denied.\p
			I'm looking at you, Bill!\n 
			Write it on a bookmark or something!\p 
			-- Sara”"),MSGBOX_SIGN)
			releaseall
			end
		}
	elif(var(VAR_DOMINION_CITY_LAB_INTRO_STATE) == 2)
		{
			msgbox(format("{PLAYER} tries the password written on the bookmark."))
			msgbox(format("The computer terminal turns on.\p
			The screen is littered with research notes. Would you like to read them?"),MSGBOX_YESNO)
				while (var(VAR_RESULT) != 1) 
				{
					getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
					setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
					addobject(LOCALID_VEE)
					applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerNorth)
					waitmovement(LOCALID_VEE)
					playse(SE_PIN)
					waitse
					applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_up))
                	waitmovement(OBJ_EVENT_ID_PLAYER)
					speakername("Vee")
					msgbox(format("Whaaat?\p You're just gonna ignore all this super-secret info?\p 
					C'mon, aren't you curious?\n What if it says something important?"))
					applymovement(LOCALID_VEE, Common_Movement_PartyMemberReturnsToPlayerNorth)
					waitmovement(LOCALID_VEE)
					removeobject(LOCALID_VEE)
					applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_left))
                	waitmovement(OBJ_EVENT_ID_PLAYER)
					closemessage
					msgbox(format("Would you like to read the research notes?"),MSGBOX_YESNO)
   				}
			closemessage
			msgbox(format(
			"You read the contents of the documents out loud for Vee.\p
			The first note reads as follows:\p
			PROJECT METAMORPHOSIS: STATUS REPORT\p
			Subject Adaptation Success Rate: 87%\p
			Voluntary Conversion Rate: 43%\p
			Reversal Feasibility: REQUIRES ADDITIONAL RESOURCES\p
			The second note reads as follows:\p
			My esteemed colleagues,\p
			We have achieved consistent success in the Pokémon conversion process.\p
			Many of our own have volunteered to undergo the transformation, embracing a stronger, more adaptable existence.\p
			Preliminary data confirms that reversal is possible, although resource intensive.\p
			Furthermore, additional adjustments are needed to ensure stability upon reversion.\p
			Priority remains on the refinement of the transformation and continued testing on non-voluntary subjects.\p
			The third note reads as follows:\p
			PROJECT METAMORPHOSIS: REVERSION PROTOCOL\p
			Reversal of transformation requires activation of eight artifacts, each infused with anomalous energy.\p
			These artifacts have been secured across the region, entrusted to subjects known as 'Guardians' for safekeeping.\p
			CURRENT ARTIFACT LOCATIONS & ASSIGNED GUARDIANS:\p
			1: Murkwell Bog\nGuardian: Redacted\p
			2: Voltbrook Town\nGuardian: Redacted\p
			3: Pyroden\nGuardian: Redacted\p
			4: Dunemire\nGuardian: Redacted\p
			5: Glacierra\nGuardian: Redacted\p
			6: Stratoscape\nGuardian: Redacted\p
			7: Abyssal Reef\nGuardian: Redacted\p
			8: Verdant Hallow\nGuardian: Redacted\p
			Access to artifacts is restricted to authorized personnel only.\p
			Retrieval is impossible without proper clearance.\p
			UNAUTHORIZED ACCESS TO THIS INFORMATION IS PUNISHABLE WITH TERMINATION\p
			One final message appears on the screen.\p
			It is a four digit number labeled 'Door Code'."))
			getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
			setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
			addobject(LOCALID_VEE)
			applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerNorth)
			waitmovement(LOCALID_VEE)
			playse(SE_PIN)
			waitse
			applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_up))
			waitmovement(OBJ_EVENT_ID_PLAYER)
			speakername("Vee")

			msgbox(format("
			Wait a second…\p
			Is this saying that people actually volunteered for this?!\NThat's…\p
			I mean, I guess being a Pokémon IS pretty awesome…\p
			But giving up being a human forever?\n
			That sounds scary!\p
			But, but!\n
			If what the note said is true, then you can go back to being a human!\p
			We just gotta, y'know…\n Find those artifacts.\p
			I bet those guardians are like…\n
			Super scary bloodthirsty Pokémon!\p
			Brr…\n
			Good thing you love to battle, right?\p
			… … …\p
			Uh, me?\n
			Yes, yes, of course!\l
			I'll help too!\p
			I'm not scared or anything!\n
			Not at all!\p
			…Well, but first…\n
			Let's get outta here!"))
			setvar(VAR_DOMINION_CITY_LAB_INTRO_STATE, 3)
			applymovement(LOCALID_VEE, Common_Movement_PartyMemberReturnsToPlayerNorth)
			waitmovement(LOCALID_VEE)
			removeobject(LOCALID_VEE)
			applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_left))
			waitmovement(OBJ_EVENT_ID_PLAYER)
		}
	else
	{
		msgbox(format("Would you like to read the research notes again?"),MSGBOX_YESNO)
			if(var(VAR_RESULT) == 1)
				{
			msgbox(format(
			"The first note reads as follows:\p
			PROJECT METAMORPHOSIS: STATUS REPORT\p
			Subject Adaptation Success Rate: 87%\p
			Voluntary Conversion Rate: 43%\p
			Reversal Feasibility: REQUIRES ADDITIONAL RESOURCES\p
			The second note reads as follows:\p
			My esteemed colleagues,\p
			We have achieved consistent success in the Pokémon conversion process.\p
			Many of our own have volunteered to undergo the transformation, embracing a stronger, more adaptable existence.\p
			Preliminary data confirms that reversal is possible, although resource intensive.\p
			Furthermore, additional adjustments are needed to ensure stability upon reversion.\p
			Priority remains on the refinement of the transformation and continued testing on non-voluntary subjects.\p
			The third note reads as follows:\p
			PROJECT METAMORPHOSIS: REVERSION PROTOCOL\p
			Reversal of transformation requires activation of eight artifacts, each infused with anomalous energy.\p
			These artifacts have been secured across the region, entrusted to subjects known as 'Guardians' for safekeeping.\p
			CURRENT ARTIFACT LOCATIONS & ASSIGNED GUARDIANS:\p
			1: Murkwell Bog\nGuardian: Redacted\p
			2: Voltbrook Town\nGuardian: Redacted\p
			3: Pyroden\nGuardian: Redacted\p
			4: Dunemire\nGuardian: Redacted\p
			5: Glacierra\nGuardian: Redacted\p
			6: Stratoscape\nGuardian: Redacted\p
			7: Abyssal Reef\nGuardian: Redacted\p
			8: Verdant Hallow\nGuardian: Redacted\p
			Access to artifacts is restricted to authorized personnel only.\p
			Retrieval is impossible without proper clearance.\p
			UNAUTHORIZED ACCESS TO THIS INFORMATION IS PUNISHABLE WITH TERMINATION\p
			One final message appears on the screen.\p
			It is a four digit number labeled 'Door Code'."))
				}
		releaseall
		end
	}
	releaseall
    end
}

script DominionCity_MagaLab_ResearchWing_EventScript_CantExitSouth
{
    lockall
	if(var(VAR_DOMINION_CITY_LAB_INTRO_STATE) < 3)
		{
			msgbox(format("The door requires a 4 digit code to unlock."))
			applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkUp)
			waitmovement(OBJ_EVENT_ID_PLAYER)
			releaseall
			end
		}
	elif(var(VAR_DOMINION_CITY_LAB_INTRO_STATE) == 3)
				{
					getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
					setobjectxyperm(LOCALID_VEE, PlayerXCoordinates, PlayerYCoordinates)
					addobject(LOCALID_VEE)
					applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerNorth)
					playse(SE_PIN)
					waitmovement(LOCALID_VEE)
					waitse
					applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_up))
					waitmovement(OBJ_EVENT_ID_PLAYER)
					speakername("Vee")
					msgbox(format("
					Alright!\n
					You got the numbers, so let's try 'em out!\p
					I bet the code is something stupid like “1234”, right?\N Right?\p
					Hey, hey! Is it working? Is it?\p
					Can you type faster?\n
					Are you done yet?\p
					Do you need help?\n
					Do you want a hug?\l
					I like hugs!"))
					applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_down))
					waitmovement(OBJ_EVENT_ID_PLAYER)
					playse(SE_DOOR)
					waitse					
					applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_up))
					waitmovement(OBJ_EVENT_ID_PLAYER)
					speakername("Vee")
					msgbox(format("
					Oooh!\n
					It worked, it worked!\p 
					We're so good at this, aren't we?\p
					Alright, now let's get out before they find us!\p
					We'll be in a world of trouble if we get caught!"))
					applymovement(LOCALID_VEE, Common_Movement_PartyMemberReturnsToPlayerNorth)
					waitmovement(LOCALID_VEE)
					removeobject(LOCALID_VEE)
					applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_down))
					waitmovement(OBJ_EVENT_ID_PLAYER)
					setvar(VAR_DOMINION_CITY_LAB_INTRO_STATE, 4)
					releaseall
					end
				}
	releaseall
	end
}

script DominionCity_MagaLab_ResearchWing_EventScript_Terminal1
{
	lockall
	msgbox(format("
	EVOFLUX INITIATIVE\p
	OBJECTIVE:\p
	Induce elemental-based adaptive evolution without requiring external catalysts.\p
	OBSERVED BEHAVIOUR:\p
	Subject 0042 failed to display form alterations under battle conditions.\p
	CONCLUSION:\p
	Results deemed inconsistent and unstable.\p
	Subject scheduled for termination and research discontinued.\p
	NOTE: Research into adaptive evolution has been redirected (see: Porygon Initiative)."))
	releaseall
	end
}
script DominionCity_MagaLab_ResearchWing_EventScript_Terminal2
{
	lockall
	msgbox(format("PORYGON ADAPTIVE EVOLUTION TRIALS\p
	OBJECTIVE:\p
	Develop an artificial Pokémon capable of rewriting its evolutionary structure dynamically.\p
	LATEST FINDINGS:\p
	- Version 1.8: Stable under controlled conditions.\p
	- Version 2.1: Unexpected self modification of combat protocols.\p
	Subject disregarded preset combat parameters.\p
	- Version 2.5: Subject exhibited signs of autonomous decision-making beyond intended programming.\p
	STATUS: Experiment under review.\p
	Further modifications are pending to ensure compliance and prevent unsanctioned adaptability."))
	release
	end
}
script DominionCity_MagaLab_ResearchWing_EventScript_Terminal3
{
	lockall
	msgbox(format("PROJECT METAMORPHOSIS\p
	SUBJECT SELECTION:\p
	Volunteers sourced from internal Team MAGA operatives.\p
	PHASE 1 RESULTS:\p
	Initial transformations deemed successful.\p
	Subjects retained cognitive function and mobility.\p
	PHASE 2 ISSUES:\p
	Irreversibility of transformation process confirmed.\p
	Reversion not possible without external stimuli (see: Artifacts).\p
	STATUS:\p
	Additional testing required.\p
	Potential candidates flagged for further trials.\p
	NOTE: Continue sourcing from interal Team MAGA operatives.\p
	If no voluenteers step forward, utilize draft protocol.\p
	Pull from military branches, starting with the airforce."))
	release
	end
}
script DominionCity_MagaLab_ResearchWing_EventScript_Book1
{	
	lockall
	msgbox(format("A handwritten note is placed as a bookmark in this book.\p
	Read it?"), MSGBOX_YESNO)
	
	if(var(VAR_RESULT) == YES)
	{
		msgbox(format(
		"Project Evo Flux aimed to induce evolution at will, removing the need for elemental catalysts.\p
		However, test subjects lacked stability, resulting in inconsistent transformations.\p
		The project has been deemed a failure.\p
		The Synthetic Evolution program presents an alternative.\p
		Rather than forcing natural evolution, we will construct an entity capable of rewriting its own code.\p
		The prototype, designated Porygon, is proving promising.\p
		Unlike Subject 0042, which lacks control over its fluctuating forms…\p 
		Porygon will be able to adapt dynamically."))
	}
	releaseall
	end
}

script DominionCity_MagaLab_ResearchWing_EventScript_Book2
{	
	lockall
	
	msgbox(format("A handwritten note is placed as a bookmark in this book.\p
	Read it?"), MSGBOX_YESNO)
	if(var(VAR_RESULT) == YES)
	{
		msgbox(format(
		"Ordered to terminate Subject 0042.\n
		“Unstable, not viable.”\p
		Ridiculous.\p
		I checked the logs.\p
		0042 was showing higher elemental synchronization than any other subject.\p
		I will try to delay the process for as long as I can.\p
		Maybe someone will see what I see before it's too late."))
	}
	releaseall
	end
}

script DominionCity_MagaLab_ResearchWing_EventScript_PilesOfBooks
{	
	lockall
	msgbox(format("Piles of scientific books lay scattered about."))
	releaseall
	end
}