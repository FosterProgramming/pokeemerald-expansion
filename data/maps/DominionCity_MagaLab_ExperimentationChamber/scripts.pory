raw `
DominionCity_MagaLab_ExperimentationChamber_MapScripts::
	.byte 0
`
script DominionCity_MagaLab_ExperimentationChamber_EventScript_DoorRequiresFourDigitCode	
{
    lockall
		msgbox(format("The door requires a 8 digit code to unlock."),MSGBOX_SIGN)
	releaseall
    end
}

script DominionCity_MagaLab_ExperimentationChamber_EventScript_ClassifiedExperiments
{
    lockall
		msgbox(format("CLASSIFIED EXPERIMENTS\nDO NOT ENTER"),MSGBOX_SIGN)
	releaseall
    end
}

script DominionCity_MagaLab_ExperimentationChamber_EventScript_ExperimentationTank
{
    lockall
		msgbox(format("There is something inside that looks like an egg.\p
		The terminal displays all kinds of numbers and letters."),MSGBOX_SIGN)
	releaseall
    end
}