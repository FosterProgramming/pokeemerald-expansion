raw `
.set LOCALID_VEE, 2
.set PlayerXCoordinates, VAR_TEMP_3
.set PlayerYCoordinates, VAR_TEMP_4
Moonthistle_House2_MapScripts::
	.byte 0

Moonthistle_House2_EventScript_HiddenPowerGiver::
	lock
	faceplayer
	goto_if_set FLAG_RECEIVED_TM_HIDDEN_POWER, Moonthistle_House2_EventScript_ExplainHiddenPower
	call_if_unset FLAG_MET_HIDDEN_POWER_GIVER, Moonthistle_House2_EventScript_Greeting
	msgbox Moonthistle_House2_Text_CoinInWhichHand, MSGBOX_DEFAULT
	multichoice 21, 8, MULTI_RIGHTLEFT, TRUE
	switch VAR_RESULT
	case 1, Moonthistle_House2_EventScript_WrongGuess
	msgbox Moonthistle_House2_Text_CorrectTryAgainWhichHand, MSGBOX_DEFAULT
	multichoice 21, 8, MULTI_RIGHTLEFT, TRUE
	switch VAR_RESULT
	case 1, Moonthistle_House2_EventScript_WrongGuess
	msgbox Moonthistle_House2_Text_CorrectTryAgainWhichHand2, MSGBOX_DEFAULT
	multichoice 21, 8, MULTI_RIGHTLEFT, TRUE
	switch VAR_RESULT
	case 0, Moonthistle_House2_EventScript_WrongGuess
	msgbox Moonthistle_House2_Text_YourHiddenPowerHasAwoken, MSGBOX_DEFAULT
	giveitem ITEM_TM_HIDDEN_POWER
	goto_if_eq VAR_RESULT, 0, Common_EventScript_ShowBagIsFull
	setflag FLAG_RECEIVED_TM_HIDDEN_POWER
	msgbox Moonthistle_House2_Text_ExplainHiddenPower, MSGBOX_DEFAULT
	release
	end

Moonthistle_House2_EventScript_Greeting::
	msgbox Moonthistle_House2_Text_HiddenPowersArousedByNature, MSGBOX_DEFAULT
	setflag FLAG_MET_HIDDEN_POWER_GIVER
	return

Moonthistle_House2_EventScript_ExplainHiddenPower::
	msgbox Moonthistle_House2_Text_ExplainHiddenPower, MSGBOX_DEFAULT
	release
	end

Moonthistle_House2_EventScript_WrongGuess::
	msgbox Moonthistle_House2_Text_YouGuessedWrong, MSGBOX_DEFAULT
	release
	end

Moonthistle_House2_Text_HiddenPowersArousedByNature:
	.string "People… POKéMON…\p"
	.string "Their hidden powers are aroused by\n"
	.string "living in natural environments…$"

Moonthistle_House2_Text_CoinInWhichHand:
	.string "Let this old woman see if your hidden\n"
	.string "power has awoken…\p"
	.string "I hold a coin in my hand.\p"
	.string "Now, tell me, have I palmed it in\n"
	.string "the right hand? Or in the left?$"

Moonthistle_House2_Text_CorrectTryAgainWhichHand:
	.string "Oh! Yes, correct!\p"
	.string "We shall try again.\p"
	.string "In which hand have I palmed the coin?\n"
	.string "The right or left?$"

Moonthistle_House2_Text_CorrectTryAgainWhichHand2:
	.string "Oh! Yes, correct!\p"
	.string "We shall try again.\p"
	.string "In which hand have I palmed the coin?\n"
	.string "The right or left?$"

Moonthistle_House2_Text_YourHiddenPowerHasAwoken:
	.string "Oh! Splendid!\n"
	.string "Your hidden power has awoken!\p"
	.string "Here, take this and awaken the hidden\n"
	.string "power of your POKéMON.$"

Moonthistle_House2_Text_ExplainHiddenPower:
	.string "HIDDEN POWER is a move that changes\n"
	.string "with the POKéMON.$"

Moonthistle_House2_Text_YouGuessedWrong:
	.string "No, too bad.\n"
	.string "You guessed wrong.$"

`
//OBJ_EVENT_GFX_SPECIES(LINOONE)
script Moonthistle_EventScripts_LinooneTrustQuestStart
{
	lock
	if(flag(FLAG_MOONTHISTLE_TRUST_QUEST_STARTED))
		{
			if(flag(FLAG_MOONTHISTLE_TRUSTED))
			{
				speakername("Linoone")
				msgbox(format("You’ve earned a place here.\pRest when you need.\nNo one will chase you off.\pFeel free to meet the others."),MSGBOX_NPC)
				release
				end
			}
			elif (flag(FLAG_MOONTHISTLE_SATCHEL_RECOVERED)) 
			{
				getplayerxy(PlayerXCoordinates,PlayerYCoordinates)
				setobjectxyperm(LOCALID_VEE,PlayerXCoordinates,PlayerYCoordinates)
				addobject(LOCALID_VEE)
				applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerWest)
				waitmovement(LOCALID_VEE)
				applymovement(LOCALID_VEE, moves(face_up))
				applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_left))
				waitmovement(LOCALID_VEE)
				applymovement(1,moves(face_down*10))
				speakername("Vee")
				msgbox(format("
				We got the satchel!\p
				A MAGA scout found us, but we stopped him.\p
				He ran off, though…"))
				applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_up))
				waitmovement(OBJ_EVENT_ID_PLAYER)
				speakername("Linoone")
				msgbox(format("
				Hmph.\p
				So, they know you're out there.\nThat won’t help our nerves.\p
				But you brought it back.\n
				Even with danger breathing down your necks.\p
				Maybe you two aren’t a liability after all.\p
				You’ve earned a place here.\p
				Rest when you need. No one will chase you off.\p
				Feel free to meet the others.\n
				Some might be more helpful than I was."))
				closemessage
				delay(40)
				speakername("Linoone")
				msgbox(format("
				That artifact story still sounds like fantasy to me.\p
				But… there's one ‘mon here who used to live in Voltbrook.\p
				Name’s Shade, the Mightyena.\n
				Keeps to the shadows, but sees more than most.\p
				If there’s a hiding spot in Voltbrook…\n
				Shade would know it."))
				applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_left))
				waitmovement(OBJ_EVENT_ID_PLAYER)
				speakername("Vee")
				msgbox(format("Thank you.\nWe won’t let you down."))
				applymovement(LOCALID_VEE,Common_Movement_PartyMemberReturnsToPlayerWest)
				waitmovement(LOCALID_VEE)
				removeobject(LOCALID_VEE)
				setflag(FLAG_MOONTHISTLE_TRUSTED)
				release
				end
			}
			else
			{
				speakername("Linoone")
				msgbox(format("You want trust?\pBring that satchel back.\nQuietly."), MSGBOX_NPC)
			}	
		}
	else
		{
			speakername("Linoone")
			msgbox(format("
			You’re not from here.\n
			And in this town, that means trouble.\p
			Wait… I know your faces.\p
			I've seen the wanted posters from Voltbrook, head the whispers of escaped experiments…\p
			How do I know you're not here to spy on us?"), MSGBOX_NPC)
			getplayerxy(PlayerXCoordinates,PlayerYCoordinates)
			setobjectxyperm(LOCALID_VEE,PlayerXCoordinates,PlayerYCoordinates)
			addobject(LOCALID_VEE)
			applymovement(LOCALID_VEE, Common_Movement_PartyMemberTalksToPlayerWest)
			waitmovement(LOCALID_VEE)
			applymovement(LOCALID_VEE, moves(face_up))
			applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_left))
			waitmovement(LOCALID_VEE)
			speakername("Vee")
			msgbox(format("
			W-We’re not here to cause any trouble! Really!\p
			We just…\n
			We’re trying to stay hidden.\l
			Just for a little while."))
			applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_up))
			waitmovement(OBJ_EVENT_ID_PLAYER)
			speakername("Linoone")
			msgbox(format("
			Letting you stay would be a big risk.\p
			How do we know we can trust you?"))
			applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_left))
			waitmovement(OBJ_EVENT_ID_PLAYER)
			speakername("Vee")
			msgbox(format("
			We're the victims here!\p
			They locked us up and ran all sorts of experiments…\p
			My friend here, he used to be human!\n
			Team MAGA transformed him into a Pokémon.
			But now that we're not useful anymore, they want to get rid of us.\p
			Please, we don’t have anywhere else to go.")
			speakername("Linoone")
			msgbox(format(
				"Hmm…\p
				I've heard the rumors…\n
				But it really does sound hard to believe…\p
				If you're speaking the truth, then prove it.\n
				Give us information that can help us defeat team MAGA.")
			))
			speakername("Vee")
			msgbox(format("
			We, uh… We did find something in the lab.\p
			N-Notes that mentioned eight artifacts.\n
			Super duper important ones."))
			applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_up))
			waitmovement(OBJ_EVENT_ID_PLAYER)
			speakername("Linoone")
			msgbox(format("Artifacts?\pYou mean like treasure?\nMagic trinkets?"))
			applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_left))
			waitmovement(OBJ_EVENT_ID_PLAYER)
			speakername("Vee")
			msgbox(format("
			Yes!\n
			Well, no?\l
			Kind of?\p
			They're connected to…\n
			Fixing what they did. To my friend.\p
			I don’t think they’ll help me.\n
			But he… He was human.\p
			And the notes said these artifacts canchange him back to the way he was!\p
			We’re sure one of the artifacts is in Voltbrook.\N
			We just need time to find it.\p
			Please. We can’t even walk around out there.\p
			They’ll send us back to the lab… or worse."))
			applymovement(OBJ_EVENT_ID_PLAYER,moves(walk_in_place_up))
			waitmovement(OBJ_EVENT_ID_PLAYER)
			speakername("Linoone")
			msgbox(format("
			…What a story.\n
			You sound like you believe it, at least.\p
			But belief alone won’t earn you shelter.\nNot here.\p
			One of ours wandered into Route 7.\nDropped a marked satchel.\lReal important.\p
			If MAGA spots it, they might trace it back here.\NWe can’t take that risk.\p
			You want trust?\pBring that satchel back.\nQuietly."))
			applymovement(LOCALID_VEE,Common_Movement_PartyMemberReturnsToPlayerWest)
			waitmovement(LOCALID_VEE)
			removeobject(LOCALID_VEE)
			setflag(FLAG_MOONTHISTLE_TRUST_QUEST_STARTED)
			clearflag(FLAG_HIDE_ROUTE_13_SATCHEL)
		}
	
	release
	end
}


//OBJ_EVENT_GFX_SPECIES(LINOONE)
script Moonthistle_EventScripts_LinooneTrustQuestComplete
{
    lock
    if (flag(FLAG_MOONTHISTLE_SATCHEL_RECOVERED)) 
	{
        speakername("Vee")
		msgbox(format("
				We got the satchel!\p
				A MAGA scout found us, but we stopped him.\p
				He ran off, though…"))
		speakername("Linoone")
		msgbox(format("
				Hmph.\p
				So, they know you're out there.\nThat won’t help our nerves.\p
				But you brought it back.\n
				Even with danger breathing down your necks.\p
				Maybe you two aren’t a liability after all.\p
				You’ve earned a place here.\p
				Rest when you need. No one will chase you off.\p
				Feel free to meet the others.\n
				Some might be more helpful than I was."))
		closemessage
		delay(40)
		speakername("Linoone")
		msgbox(format("
				That artifact story still sounds like fantasy to me.\p
				But… there's one ‘mon here who used to live in Voltbrook.\p
				Name’s Shade, the Mightyena.\n
				Keeps to the shadows, but sees more than most.\p
				If there’s a hiding spot in Voltbrook…\n
				Shade would know it."))
		speakername("Vee")
		msgbox(format("Thank you.\nWe won’t let you down."))
		setflag(FLAG_MOONTHISTLE_TRUSTED)
		release
		end
    }
    speakername("Vee")
    msgbox(format("
				We got the satchel!\p
				A MAGA scout found us, but we stopped him.\p
				He ran off, though…"))
    speakername("Linoone")
    msgbox(format("
				Hmph.\p
				So, they know you're out there.\nThat won’t help our nerves.\p
				But you brought it back.\n
				Even with danger breathing down your necks.\p
				Maybe you two aren’t a liability after all.\p
				You’ve earned a place here.\p
				Rest when you need. No one will chase you off.\p
				Feel free to meet the others.\n
				Some might be more helpful than I was."))
	closemessage
	delay(40)
    speakername("Linoone")
    msgbox(format("That artifact story still sounds like fantasy to me.\pBut… there's one ‘mon here who used to live in Voltbrook.\pName’s Shade. Mightyena. Keeps to the shadows, but sees more than most.\pIf there’s a hiding spot in Voltbrook… Shade would know it."))
    speakername("Vee")
    msgbox(format("Thank you.\nWe won’t let you down."))
    setflag(FLAG_MOONTHISTLE_TRUSTED)
    release
    end
}
