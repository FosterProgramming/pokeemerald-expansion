mapscripts DeleteThis_MapScripts {

}

script TestFirePit_Script {
	lock
	if(flag(FLAG_WILLOWISP_ACTIVE))
	{
		if(flag(FLAG_TEMP_4) && flag(FLAG_TEMP_5) && flag(FLAG_TEMP_6))
		{
			call(OpenDoorTestScript)
		}
		else
		{
			delay(20)
			setvar(VAR_0x8000, 2)
			callnative(SetFirePitOff)
			setvar(VAR_0x8000, 3)
			callnative(SetFirePitOff)
			setvar(VAR_0x8000, 4)
			callnative(SetFirePitOff)
		}
		clearflag(FLAG_WILLOWISP_ACTIVE)
	}
	else{
		checkitem(ITEM_STRENGTH_TOOL)
		if(var(VAR_RESULT) == TRUE)
		{
		goto(EventScript_StrengthBoulder)
		}
	}
	release
	end
}

