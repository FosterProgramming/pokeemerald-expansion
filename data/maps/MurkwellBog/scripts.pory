raw `
.set LOCALID_NYX, 7
.set LOCALID_EEVEE, 9
.set LOCALID_DRAKE, 10
.set LOCALID_ACE, 11
.set LOCALID_TALON, 12
.set PlayerXCoordinates, VAR_TEMP_3
.set PlayerYCoordinates, VAR_TEMP_4
`

mapscripts MurkwellBog_MapScripts
{
}
script MurkwellBog_EventScripts_SlowpokeNPC
{
	lockall
	msgbox(format("Huh… I don't remember the swamp bein' this… cloudy. These things weren't always floatin' around, right? Huh… Was it always like this?"))
	releaseall
	end
}

script MurkwellBog_EventScripts_ParasectNPC
{
	lockall
	msgbox(format("The air is… heavy. My spores mix with it, but something else lingers here. Something that wasn't here before."))
	releaseall
	end
}

script MurkwellBog_EventScripts_DrowzeeNPC
{
	lockall
	msgbox(format("I tried to enter the temple the other night. Ever since, the air feels… thick. My dreams feel like I'm breathing it in."))
	releaseall
	end
}

script MurkwellBog_EventScripts_HaunterNPC
{
	lockall
	msgbox(format("Oh, the temple? Heh… It's just an old ruin! Nothin' special… Nope, nothin' at all! And, uh, you definitely don't wanna go there. Definitely."))
	releaseall
	end
}

script MurkwellBog_EventScripts_LanturnNPC
{
	lockall
	msgbox(format("My light doesn't reach as far anymore… It's like the air itself is swallowing it. I've guided Pokémon through here for years, but lately, I can barely see the way myself."))
	releaseall
	end
}

script MurkwellBog_EventScripts_HoothootNPC
{
	lockall
	applymovement(6,moves(face_down))
	msgbox(format("The temple's always been there. But lately… the air around it shimmers. I don't like looking at it. It feels like it's moving."))
	releaseall
	end
}

//OBJ_EVENT_GFX_SPECIES(VENOMOTH)
script MurkwellBog_EventScripts_NyxNPC
{
	lockall
	speakername("???")
	faceplayer
	msgbox(format("Have you retreived the lost items?\pA Hard Stone\pA Spell Tag\pA Charcoal Fragment"),MSGBOX_YESNO)
	if(var(VAR_RESULT) != 1)
		{
			speakername("???")
			faceplayer
			msgbox(format("Go, then.\pSeek what is lost.\pAnd if the temple answers… perhaps I shall walk this path with you."))
			releaseall
			end
		}
	else
		{
			if(checkitem(ITEM_CHARCOAL) == TRUE)
			{
				if(checkitem(ITEM_SPELL_TAG) == TRUE)
					{
						if(checkitem(ITEM_HARD_STONE) == TRUE)
							{
								speakername("???")
								faceplayer
								msgbox(format("The offerings have been gathered.\pStand back, I will perform the ritual."))
								getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
									if(var(PlayerXCoordinates) == 14) // @ 14/14
										{
											applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_right walk_in_place_up))
											waitmovement(OBJ_EVENT_ID_PLAYER)
										}
									elif(var(PlayerXCoordinates) == 13) // @ 13/13
										{
											applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down walk_right * 2 walk_in_place_up))
											waitmovement(OBJ_EVENT_ID_PLAYER)
										}
									else // @ 15/13 -> 15/14
										{
											applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down walk_in_place_up))
											waitmovement(OBJ_EVENT_ID_PLAYER)
										}
								special(SpawnCameraObject)
								applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up * 3))
								applymovement(LOCALID_NYX, moves(walk_right walk_up * 3 emote_exclamation_mark))
								waitmovement(LOCALID_NYX)
								call(CommonEventScript_ScreenShake)
								playse(SE_EFFECTIVE)
								delay(40)
								removeobject(8)
								waitse
								applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_down * 3))
								applymovement(LOCALID_NYX, moves(walk_down * 3))
								waitmovement(LOCALID_NYX)
								getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
								msgbox(format("…It is done.\pThe seal has lifted.\pThe temple awaits."))
								faceplayer
								call(Murkwellbog_CommonEventScript_SetLocalIdsToPlayerXY)
								goto(Murkwellbog_CommonEventScript_DetermineParty)
							}
					}
			}
			else
			{
				speakername("???")
				faceplayer
				msgbox(format("A liars tounge will heed you no entry.\pGo, then.\pSeek what is lost.\pAnd if the temple answers… perhaps I shall walk this path with you."))
				releaseall
				end
			}
		}
}

