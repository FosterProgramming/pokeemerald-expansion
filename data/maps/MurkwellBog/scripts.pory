//OBJ_EVENT_GFX_SPECIES(AIPOM)
script MurkwellBog_EventScripts_ShopkeeperNPC
{
	lock
	msgbox(format("Welcome! Got all sorts of goods! Just… don't ask where I got 'em. The bog provides… heh."))
	waitmessage
	pokemart(MurkwellBog_MartItems)
	msgbox(format("Come again soon…"))
	release
	end
}

mart MurkwellBog_MartItems
	{
		ITEM_CLEANSE_TAG    // Wards off evil spirits, used by cautious Pokémon.
        ITEM_TWISTED_SPOON  // Boosts Psychic-type moves, carried by mystics in the bog.
        ITEM_BIG_ROOT       // Enhances draining moves, fits the swampy, life-absorbing theme.
        ITEM_HEAL_POWDER    // Herbal remedy for status conditions, commonly used by swamp dwellers.
        ITEM_ENERGY_ROOT    // Strong but bitter healing item, known for its powerful effects.
        ITEM_REVIVAL_HERB   // Fully revives fainted Pokémon but is bitter--rare in standard marts.
        ITEM_TINYMUSHROOM   // Small fungi commonly found in damp environments.
        ITEM_BIG_MUSHROOM   // Larger version, often sold by Pokémon for currency.
        ITEM_SITRUS_BERRY   // Restores HP, useful for adventurers exploring Murkwell.
        ITEM_LUM_BERRY      // Cures any status condition, highly valued in such a hazardous area.
	}

