{
	lockall
	msgbox(format("You ever notice how the trees move? Not just in the wind… they shift when you ain't lookin'. Always facin' the temple…"))
	releaseall
	end
}

//OBJ_EVENT_GFX_SPECIES(MAROWAK)
script MurkwellBog_EventScripts_HomebodyNPC3
{
	lockall
	msgbox(format("My kin are buried here… but lately, I don't feel alone when I visit. Someone else watches the graves…"))
	releaseall
	end
}

script MurkwellBog_EventScripts_TempleNeedsRitual
{
	lock
	applymovement(LOCALID_NYX, moves(emote_question_mark))
	waitmovement(LOCALID_NYX)
	getplayerxy(PlayerXCoordinates, PlayerYCoordinates)
		if(var(PlayerXCoordinates) < 16)
			{
				applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up *2 walk_in_place_left))
				waitmovement(OBJ_EVENT_ID_PLAYER)
			}
		else
			{
				applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up *2 walk_left))
				waitmovement(OBJ_EVENT_ID_PLAYER)
			}
	speakername("???")
	msgbox(format("…\pYou do not belong here.\pAnd yet, the voices stir.\pHow curious."))
	msgbox(format("This place does not open its secrets to just anyone.\pThe lost whisper of those who have come before.\pBut only one with the right presence may listen."))
	msgbox(format("You… are different.\pThe echoes follow you, bending around your path.\pThat inscription--it reacts to you, not the others."))
	msgbox(format("This door was not always shut.\pSomething lingers, unseen.\pNot a lock. Not a barrier.\pSomething… watching."))
	msgbox(format("I have spent long years studying what remains of the old ways.\pThis seal is unnatural.\pIts origin unknown.\pAnd yet, there is always a way through."))
	msgbox(format("The temple rejects the living, but it does not ignore the past.\pAn offering--proof of those who walked before--may force its hand."))
	msgbox(format("Three remnants must be gathered:\pA Hard Stone\pA Spell Tag\pA Charcoal Fragment"))
	msgbox(format("Only these may wake the ruin.\pOnly then will might path open."))
	msgbox(format("Go, then.\pSeek what is lost.\pAnd if the temple answers… perhaps I shall walk this path with you."))
	setvar(VAR_MURKWELL_BOG_STATE, 1)
	release
	end
}

script MurkwellBog_EventScript_NyxNPC_AdditionalPartyMemberDrakeDialogue
{
	if(flag(FLAG_HIDE_STRATOSCAPE_DRAKE))
		{
			addobject(LOCALID_DRAKE)
			if(var(PlayerXCoordinates) == 14) // @ 14/14
				{
					applymovement(LOCALID_DRAKE, moves(walk_right walk_up face_left emote_exclamation_mark))
					waitmovement(LOCALID_DRAKE)
					playse(SE_PIN)
					waitse
					speakername("Drake")
					msgbox(format("Ancient rites, lost echoes…\pIt is good to remember the past.\pBut be wary. Some things are buried for a reason."))
					applymovement(LOCALID_DRAKE, moves(walk_down walk_left))
					waitmovement(LOCALID_DRAKE)
					removeobject(LOCALID_DRAKE)
				}
			elif(var(PlayerXCoordinates) == 13) // @ 13/13
				{
					applymovement(LOCALID_DRAKE, moves(walk_down walk_right face_up))
					waitmovement(LOCALID_DRAKE)
					playse(SE_PIN)
					waitse
					speakername("Drake")
					msgbox(format("Ancient rites, lost echoes…\pIt is good to remember the past.\pBut be wary. Some things are buried for a reason."))
					applymovement(LOCALID_DRAKE, moves(walk_left walk_up))
					waitmovement(LOCALID_DRAKE)
					removeobject(LOCALID_DRAKE)
				}
			else // @15/14
				{
					applymovement(LOCALID_DRAKE, moves(walk_left walk_up face_right))
					waitmovement(LOCALID_DRAKE)
					playse(SE_PIN)
					waitse
					speakername("Drake")
					msgbox(format("Ancient rites, lost echoes…\pIt is good to remember the past.\pBut be wary. Some things are buried for a reason."))
					applymovement(LOCALID_DRAKE, moves(walk_right walk_down))
					waitmovement(LOCALID_DRAKE)
					removeobject(LOCALID_DRAKE)
				}
		}
	return
}
