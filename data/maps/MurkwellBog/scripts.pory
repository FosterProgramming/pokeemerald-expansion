script Murkwellbog_EventScript_NyxOpenedTemple_AceTalonParty
{
	addobject(LOCALID_EEVEE)
	addobject(LOCALID_ACE)
	addobject(LOCALID_TALON)
	applymovement(LOCALID_EEVEE, Common_Movement_PartyMemberTalksToPlayerWest)
	applymovement(LOCALID_ACE, Common_Movement_PartyMemberTalksToPlayerEast)
	applymovement(LOCALID_TALON, Common_Movement_PartyMemberTalksToPlayerSouth)
	speakername("Vee")
	msgbox(format("Whoa, that was kinda cool.\pSo, uh… what do we call you, anyway?"))
	speakername("???")
	msgbox(format("Names are… fleeting.\pBut if you must, you may call me Nyx."))
	applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_right))
	waitmovement(OBJ_EVENT_ID_PLAYER)
	speakername("Ace")
	msgbox(format("So, we’re actually going in there, huh?"))
	applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_left))
	waitmovement(OBJ_EVENT_ID_PLAYER)
	speakername("Vee")
	msgbox(format("Yeah, ‘cause running away sounds soooo smart right now."))
	applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_down))
	waitmovement(OBJ_EVENT_ID_PLAYER)
	speakername("Talon")
	msgbox(format("If something goes wrong, we fight our way out. Simple."))
	applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_up))
	waitmovement(OBJ_EVENT_ID_PLAYER)
	speakername("Nyx")
	msgbox(format("Not everything can be fought. Some things must be understood.\pI will accompany you inside.\pThere is more yet to uncover."))
	applymovement(LOCALID_NYX, moves(walk_down))
	waitmovement(LOCALID_NYX)
	removeobject(LOCALID_NYX)
	removeobject(8)
	playfanfare(MUS_OBTAIN_ITEM)
