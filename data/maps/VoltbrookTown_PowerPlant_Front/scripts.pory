script VoltbrookTown_PowerPlant_Front_PlantWorkerNPC
{
	lockall
    msgbox(format("
    Team MAGA acts like they're doing us a favor.\p
    Ever since they took over our town the people and Pokémon have been living in fear."), MSGBOX_NPC)
    releaseall
    end
}